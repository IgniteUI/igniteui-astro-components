{
  "name": "igniteui-astro-components",
  "version": "0.1.0",
  "description": "Reusable Astro components, layouts, and integrations for Infragistics / Ignite UI documentation sites. Replaces the Starlight defaults with project-specific implementations.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "Infragistics",
  "repository": {
    "type": "git",
    "url": "https://github.com/IgniteUI/igniteui-astro-components"
  },
  "keywords": [
    "astro",
    "astro-component",
    "astro-integration",
    "documentation",
    "docs",
    "infragistics",
    "ignite-ui",
    "sidebar",
    "mdx"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./integration": "./src/integration.ts",
    "./sidebar": "./src/sidebar.ts",
    "./platform": "./src/platform.ts",
    "./content": "./src/content-helper.ts",
    "./content-config": "./src/content.config.ts",
    "./llms": "./src/llms.ts",
    "./layouts/DocsLayout.astro": "./src/layouts/DocsLayout/DocsLayout.astro",
    "./components/GlobalNavBar.astro": "./src/components/GlobalNavBar/GlobalNavBar.astro",
    "./components/GlobalFooter.astro": "./src/components/GlobalFooter/GlobalFooter.astro",
    "./components/DocsSubHeader.astro": "./src/components/DocsSubHeader/DocsSubHeader.astro",
    "./components/Search.astro": "./src/components/Search/Search.astro",
    "./components/SearchAdvanced.astro": "./src/components/SearchAdvanced/SearchAdvanced.astro",
    "./components/ThemingWidget.astro": "./src/components/ThemingWidget/ThemingWidget.astro",
    "./components/MobileSidebarToggle.astro": "./src/components/MobileSidebarToggle/MobileSidebarToggle.astro",
    "./components/MobileTocToggle.astro": "./src/components/MobileTocToggle/MobileTocToggle.astro",
    "./components/DocsToc.astro": "./src/components/DocsToc/DocsToc.astro",
    "./components/DocsSidebar/DocsSidebar.astro": "./src/components/DocsSidebar/DocsSidebar.astro",
    "./components/DocsSidebar/SidebarFilterInput.astro": "./src/components/DocsSidebar/SidebarFilterInput.astro",
    "./components/DocsSidebar/SidebarLabel.astro": "./src/components/DocsSidebar/SidebarLabel.astro",
    "./components/DocsSidebar/sidebar-filter": "./src/components/DocsSidebar/sidebar-filter.ts",
    "./components/DocsSidebar/toTreeNodes": "./src/components/DocsSidebar/toTreeNodes.ts",
    "./components/DocsToc/toTreeNodes": "./src/components/DocsToc/toTreeNodes.ts",
    "./components/DocsTree/DocsTree.astro": "./src/components/DocsTree/DocsTree.astro",
    "./components/DocsTree/DocsTreeItem.astro": "./src/components/DocsTree/DocsTreeItem.astro",
    "./components/DocsTree/types": "./src/components/DocsTree/types.ts",
    "./components/DocsTree/docs-tree.css": "./src/components/DocsTree/docs-tree.css",
    "./components/mdx/ApiRef.astro": "./src/components/mdx/ApiRef/ApiRef.astro",
    "./components/mdx/ApiLink.astro": "./src/components/mdx/ApiLink/ApiLink.astro",
    "./components/mdx/DocsAside.astro": "./src/components/mdx/DocsAside/DocsAside.astro",
    "./components/mdx/PlatformBlock.astro": "./src/components/mdx/PlatformBlock/PlatformBlock.astro",
    "./components/mdx/Sample.astro": "./src/components/mdx/Sample/Sample.astro",
    "./lib/sidebar/types": "./src/lib/sidebar/types.ts",
    "./lib/sidebar/helpers": "./src/lib/sidebar/helpers.ts",
    "./lib/types": "./src/lib/types.ts",
    "./plugins/remark-docfx": "./src/plugins/remark-docfx.ts",
    "./plugins/rehype-table-wrapper": "./src/plugins/rehype-table-wrapper.ts",
    "./plugins/rehype-heading-anchors": "./src/plugins/rehype-heading-anchors.ts",
    "./styles/custom.scss": "./src/styles/custom.scss",
    "./styles/theme.scss": "./src/styles/theme.scss",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0",
    "igniteui-webcomponents": "^7.1.3"
  },
  "peerDependenciesMeta": {
    "igniteui-webcomponents": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "igniteui-webcomponents": "^7.1.3",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "astro": "^6.1.6",
    "igniteui-theming": "^26.0.1",
    "sass": "^1.83.0",
    "typescript": "^5.6.0"
  },
  "workspaces": [
    "playground"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "playground": "npm --prefix playground run dev",
    "playground:dev": "npm --prefix playground run dev",
    "playground:build": "npm --prefix playground run build",
    "playground:preview": "npm --prefix playground run preview",
    "playground:clean": "npm --prefix playground run clean",
    "playground:check": "npm --prefix playground run check"
  }
}

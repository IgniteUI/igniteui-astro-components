---
/**
 * DocsSubHeader
 *
 * A secondary fixed header bar rendered below the GlobalNavBar.
 * Contains the search input and cross-product navigation links.
 *
 * Positioning (set in DocsLayout / custom.css):
 *   --docs-global-nav-height   height of the GlobalNavBar above (default 86px)
 *   --docs-subheader-height    height of this bar (default 40px)
 *
 * Note: The breadcrumb that previously lived in `.subheader-context` has been
 * moved to the `DocsBreadcrumb` component, rendered inside the main frame.
 */
import { platform as virtualPlatform } from 'virtual:docs-template/nav-html';
import { productLinks, sidebar as sidebarData, title as siteTitle } from 'virtual:docs-template/site-meta';
import Search from '../Search/Search.astro';
import type { SidebarEntry } from '../../lib/sidebar/types';
import { getBreadcrumb } from '../../lib/sidebar/helpers';
import logoRaw from '../../assets/ig-logo.svg?raw';
import './DocsSubHeader.scss';

interface ProductLink {
  label: string;
  href: string;
  platform?: string;
}

interface Props {
  /** Fallback title if the slug is not present in the sidebar tree. */
  pageTitle?: string | null;
  /** Current page slug — used to derive the breadcrumb from the sidebar tree. */
  currentSlug?: string;
  /**
   * Override the site title shown on the left. Defaults to the virtual module value.
   * Useful when consuming without `siteMetaIntegration`.
   */
  siteTitle?: string;
  /**
   * Override the cross-product navigation links. Defaults to the virtual module value.
   * Useful when consuming without `siteMetaIntegration`.
   */
  productLinks?: ProductLink[];
  /**
   * Override the sidebar tree used for breadcrumb generation.
   * Defaults to the virtual module value.
   */
  sidebarItems?: SidebarEntry[];
  /** Package names for the package selector dropdown. When omitted the selector is hidden. */
  packages?: string[];
  /** Currently selected package (must match one of `packages`). */
  selectedPackage?: string;
  /** Label rendered before the package selector. Defaults to `'Package'`. */
  packageLabel?: string;
  /** Version labels for the version selector dropdown. When omitted the selector is hidden. */
  versions?: string[];
  /** Currently selected version (must match one of `versions`). */
  selectedVersion?: string;
  /** Label rendered before the version selector. Defaults to `'Version'`. */
  versionLabel?: string;
  /** Show a light/dark theme toggle button. */
  showThemeToggle?: boolean;
  /** `localStorage` key for persisting the theme. Defaults to `'docs-theme'`. */
  themeStorageKey?: string;
}

const {
  pageTitle = '',
  currentSlug = '',
  siteTitle: siteTitleProp,
  productLinks: productLinksProp,
  sidebarItems,
  packages,
  selectedPackage,
  packageLabel = 'Package',
  versions,
  selectedVersion,
  versionLabel = 'Version',
  showThemeToggle = false,
  themeStorageKey = 'docs-theme',
} = Astro.props;
const resolvedSiteTitle = siteTitleProp ?? siteTitle;
const currentPlatform = virtualPlatform ?? null;
const resolvedLinks = (productLinksProp ?? productLinks) as ProductLink[];
const filteredLinks = resolvedLinks.filter((l: ProductLink) => l.platform !== currentPlatform);

const resolvedSidebar = (sidebarItems ?? sidebarData) as SidebarEntry[];
const sidebarCrumbs = currentSlug ? getBreadcrumb(resolvedSidebar, currentSlug) : [];
const crumbs = sidebarCrumbs.length > 0 ? sidebarCrumbs : (pageTitle ? [pageTitle] : []);
---

<docs-subheader-menu class="docs-subheader">
    <div class="igd-logo">
        <Fragment set:html={logoRaw} />
        <h1 class="ig-typography__body-2">IgniteUI</h1>
    </div>

    <!-- Left: title area, takes all free space -->
    <div class="subheader-context">
        {resolvedSiteTitle && <span class="subheader-site-title">{resolvedSiteTitle}</span>}
        {crumbs.map((label, i) => (
            <>
                <span class="subheader-sep" aria-hidden="true">{i === 0 ? '-' : '/'}</span>
                <span class="subheader-crumb" title={label}>{label}</span>
            </>
        ))}
    </div>

    <!-- Search (overridable via named slot) -->
    <slot name="search"><Search /></slot>

    <!-- Package selector (optional) -->
    {packages && packages.length > 0 && (
        <div class="selector-group">
            <igc-select id="package-select" outlined value={selectedPackage} aria-label={packageLabel}>
                {packages.map((p) => (
                    <igc-select-item value={p}>{p}</igc-select-item>
                ))}
            </igc-select>
        </div>
    )}

    <!-- Version selector (optional) -->
    {versions && versions.length > 0 && (
        <div class="selector-group">
            <igc-select id="version-select" outlined value={selectedVersion} aria-label={versionLabel}>
                {versions.map((v) => (
                    <igc-select-item value={v}>{v}</igc-select-item>
                ))}
            </igc-select>
        </div>
    )}

    <!-- Right: theme toggle + product links. Desktop: flex row. Mobile: absolute dropdown. -->
    <div class="subheader-right" id="docs-subheader-panel">
        {showThemeToggle && (
            <igc-icon-button class="subheader-theme-toggle" variant="flat" data-theme-toggle data-theme-key={themeStorageKey} aria-label="Toggle theme" title="Toggle light/dark theme">
                <svg class="theme-icon-light" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                <svg class="theme-icon-dark" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </igc-icon-button>
        )}
        {filteredLinks.length > 0 && (
            <div class="subheader-links">
                {filteredLinks.map((link, i) => (
                    <>
                        {i > 0 && <span class="product-sep" aria-hidden="true">|</span>}
                        <a href={link.href} class="product-link">{link.label}</a>
                    </>
                ))}
            </div>
        )}
    </div>

    <!-- Mobile toggle (hidden on desktop) -->
    <button
        class="subheader-toggle"
        data-docs-toggle
        aria-expanded="false"
        aria-controls="docs-subheader-panel"
        aria-label="Toggle navigation"
    >
        <svg class="icon-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6"  x2="21" y2="6"  />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6"  x2="6"  y2="18" />
            <line x1="6"  y1="6"  x2="18" y2="18" />
        </svg>
    </button>
</docs-subheader-menu>

<script>
    if (!customElements.get('docs-subheader-menu')) {
        class DocsSubHeaderMenu extends HTMLElement {
            connectedCallback() {
                const btn = this.querySelector<HTMLButtonElement>('[data-docs-toggle]');
                if (!btn) return;

                const setExpanded = (expanded: boolean) => {
                    this.setAttribute('aria-expanded', String(expanded));
                    btn.setAttribute('aria-expanded', String(expanded));
                };

                btn.addEventListener('click', () => {
                    setExpanded(this.getAttribute('aria-expanded') !== 'true');
                });

                document.addEventListener('keyup', (e: KeyboardEvent) => {
                    if (e.key === 'Escape' && this.getAttribute('aria-expanded') === 'true') {
                        setExpanded(false);
                        btn.focus();
                    }
                });

                this.addEventListener('focusout', (e: FocusEvent) => {
                    if (!this.contains(e.relatedTarget as Node)) setExpanded(false);
                });

                document.addEventListener('click', (e: MouseEvent) => {
                    if (!this.contains(e.target as Node)) setExpanded(false);
                });

                // Theme toggle
                const themeBtn = this.querySelector<HTMLElement>('[data-theme-toggle]');
                if (themeBtn) {
                    themeBtn.addEventListener('click', () => {
                        const current = document.documentElement.getAttribute('data-theme');
                        const next = current === 'dark' ? 'light' : 'dark';
                        document.documentElement.setAttribute('data-theme', next);
                        const key = themeBtn.dataset.themeKey || 'docs-theme';
                        try { localStorage.setItem(key, next); } catch (_) {}
                    });
                }
            }
        }

        customElements.define('docs-subheader-menu', DocsSubHeaderMenu);
    }
</script>

<script>
    import {
        defineComponents,
        IgcSelectComponent,
        IgcSelectItemComponent,
        IgcIconButtonComponent,
    } from 'igniteui-webcomponents';

    defineComponents(IgcSelectComponent, IgcSelectItemComponent, IgcIconButtonComponent);
</script>

<style>
    docs-subheader-menu {
        display: contents;
    }

    /* ── Fixed bar ─────────────────────────────────────────────────────────── */

    .docs-subheader {
        position: fixed;
        inset-inline-start: 0;
        inset-block-start: var(--docs-global-nav-height, 4.7rem);
        width: 100%;
        height: var(--docs-subheader-height, 2.5rem);
        z-index: calc(var(--sl-z-index-navbar) - 1);
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.75rem;
        padding-inline: 1rem;
        background-color: var(--sl-color-bg-nav);
        border-bottom: 1px solid var(--sl-color-hairline-shade);
        overflow: visible;
    }

    /* ── Context (left) ────────────────────────────────────────────────────── */

    .subheader-context {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.375rem;
        overflow: hidden;
    }

    .subheader-site-title {
        flex-shrink: 0;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--sl-color-text-accent);
        white-space: nowrap;
    }

    .subheader-page-title {
        font-size: 0.875rem;
        color: var(--sl-color-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .subheader-crumb {
        flex-shrink: 0;
        font-size: 0.875rem;
        color: var(--sl-color-gray-4);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 14rem;
    }

    .subheader-sep {
        flex-shrink: 0;
        color: var(--sl-color-gray-3);
        font-size: 0.875rem;
        user-select: none;
    }

    /* ── Selectors (optional) ──────────────────────────────────────────────── */

    .selector-group {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        white-space: nowrap;
    }

    .selector-group igc-select {
        min-width: 100px;
        --ig-size: 1;
    }

    /* ── Theme toggle (optional) ────────────────────────────────────────────── */

    .subheader-theme-toggle {
        --ig-size: 1;
        color: var(--sl-color-text);
    }

    .subheader-theme-toggle .theme-icon-dark { display: none; }
    :global([data-theme='dark']) .subheader-theme-toggle .theme-icon-light { display: none; }
    :global([data-theme='dark']) .subheader-theme-toggle .theme-icon-dark { display: block; }

    /* ── Right side: links ──────────────────────────────────────────────────── */

    .subheader-right {
        flex-shrink: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
    }

    .subheader-links {
        display: flex;
        flex-direction: row;
        align-items: center;
        flex-wrap: nowrap;
        gap: 0;
    }

    .product-link {
        font-size: 0.75rem;
        color: var(--sl-color-gray-2);
        text-decoration: none;
        white-space: nowrap;
        padding-inline: 0.25rem;
        line-height: 1;
        transition: color 0.15s;
    }

    .product-link:hover,
    .product-link:focus-visible {
        color: var(--sl-color-text-accent);
        text-decoration: underline;
    }

    .product-sep {
        flex-shrink: 0;
        font-size: 0.6875rem;
        color: var(--sl-color-gray-4);
        padding-inline: 0.125rem;
        line-height: 1;
        user-select: none;
    }

    /* ── Mobile toggle (hidden on desktop) ─────────────────────────────────── */

    .subheader-toggle {
        display: none;
        flex-shrink: 0;
        padding: 0.25rem;
        background: none;
        border: none;
        border-radius: 0.25rem;
        color: var(--sl-color-text);
        cursor: pointer;
        line-height: 0;
    }

    /* ══ Mobile (≤ 50rem) ══════════════════════════════════════════════════════ */

    @media (max-width: 50rem) {
        .selector-group { display: none; }

        .subheader-right {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            background-color: var(--sl-color-bg-nav);
            border-bottom: 1px solid var(--sl-color-hairline-shade);
            box-shadow: var(--sl-shadow-md);
        }

        docs-subheader-menu[aria-expanded='true'] .subheader-right {
            display: flex;
        }

        .subheader-links {
            flex-wrap: wrap;
        }

        .product-link {
            font-size: 0.875rem;
            padding-block: 0.25rem;
        }

        .subheader-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .subheader-toggle:hover,
        .subheader-toggle:focus-visible {
            background-color: var(--sl-color-hairline);
        }

        docs-subheader-menu[aria-expanded='true'] .subheader-toggle .icon-open  { display: none; }
        docs-subheader-menu:not([aria-expanded='true']) .subheader-toggle .icon-close { display: none; }
    }
</style>

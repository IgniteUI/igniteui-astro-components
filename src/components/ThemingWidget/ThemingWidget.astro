---
/**
 * ThemingWidget
 *
 * A compact theme picker dropdown used inside sample viewers. The trigger shows
 * the active theme (a small multi-dot color swatch + the theme name and, when a
 * mode is active, a muted label with the mode it resolves to). Opening the
 * trigger reveals a panel with:
 *
 *   • an optional MODE row — three icon toggles for Light / Dark / System, and
 *   • a list of selectable themes, each with its swatch; the active one is checked.
 *
 * The widget is self-contained (no web-component dependency): icons are inlined
 * SVGs and all behavior is wired by a small client script. On change it:
 *   • dispatches a bubbling `igd-theme-change` CustomEvent with
 *     `{ theme, mode, modePreference }`, and
 *   • reflects `data-igd-theme` / `data-igd-mode` on the optional `target` element.
 *
 * `system` is resolved against the OS `prefers-color-scheme` before it leaves
 * the widget: `mode` (and everything reflected onto `target`) is always a
 * concrete `light` / `dark`, while `modePreference` keeps the raw selection.
 * While `system` is selected the widget follows OS changes live, re-reflecting
 * and re-emitting whenever the preference flips.
 *
 * The selection is not persisted — the widget resets to its initial props on
 * every page load.
 *
 * When `selectedTheme` / `mode` are omitted the widget falls back to the docs
 * host's ambient configuration — `defaultSampleTheme` / `defaultSampleMode` on
 * `Astro.locals.envVars` — so a site sets its starting theme once instead of at
 * every call site.
 *
 * The panel is promoted to a native popover (top layer) when the browser
 * supports it, so it escapes any clipping/stacking ancestor — e.g. the sample
 * container's `overflow: hidden`. Its position is computed from the trigger and
 * flips above it when there is not enough room below; when constrained it gets
 * a `max-height` and scrolls. Browsers without the Popover API fall back to the
 * absolutely positioned panel, which still flips.
 *
 * Mirrors the "Theme-Input-Dropdown" design from the Doc Samples Figma file.
 */
import './ThemingWidget.scss';

export interface ThemeOption {
  /** Stable identifier, also used as the value in events. */
  name: string;
  /** Display label. Defaults to a title-cased `name`. */
  label?: string;
  /** Swatch dot colors (left → right). Any length; the design uses three. */
  swatch: string[];
}

export type ThemeMode = 'light' | 'dark' | 'system';

interface Props {
  /** Selectable themes. Defaults to Material, Fluent, Bootstrap and Indigo. */
  themes?: ThemeOption[];
  /**
   * Active theme `name`. When omitted, falls back to the host's
   * `defaultSampleTheme` env var and then to the first theme.
   */
  selectedTheme?: string;
  /**
   * Active color mode. When omitted, falls back to the host's
   * `defaultSampleMode` env var and then to `'light'`.
   */
  mode?: ThemeMode;
  /** Show the MODE (Light / Dark / System) toggle row. Defaults to `true`. */
  showMode?: boolean;
  /** Element id for the root. Defaults to an auto-generated id. */
  id?: string;
  /** Extra class(es) forwarded to the root. */
  class?: string;
  /** Accessible label for the trigger. Defaults to `'Select theme'`. */
  label?: string;
  /**
   * CSS selector for an element to reflect the selection onto via
   * `data-igd-theme` / `data-igd-mode`. When omitted, nothing is reflected.
   */
  target?: string;
}

const DEFAULT_THEMES: ThemeOption[] = [
  { name: 'material', label: 'Material', swatch: ['#000000', '#df1b74', '#0099ff'] },
  { name: 'fluent', label: 'Fluent', swatch: ['#000000', '#0078D4', '#2B88D8'] },
  { name: 'bootstrap', label: 'Bootstrap', swatch: ['#000000', '#0D6EFD', '#6C757D'] },
  { name: 'indigo', label: 'Indigo', swatch: ['#000000', '#3F51B5', '#3F51B5'] },
];

const {
  themes = DEFAULT_THEMES,
  selectedTheme,
  mode: modeProp,
  showMode = true,
  id,
  class: className,
  label = 'Select theme',
  target,
} = Astro.props;

const rootId = id ?? `igd-theming-${Math.random().toString(36).slice(2, 9)}`;

const titleCase = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// Ambient defaults published by the docs host on `Astro.locals.envVars` (set
// there by its middleware). Reading them means a widget rendered without props
// still opens on the theme the surrounding site ships, instead of every call
// site having to pass one. `locals` is `{}` when the consumer has no
// middleware, so this degrades to the built-in defaults.
const env = Astro.locals.envVars ?? {};

const activeName = selectedTheme ?? env.defaultSampleTheme ?? themes[0]?.name;
const active = themes.find((t) => t.name === activeName) ?? themes[0];
const activeLabel = active ? (active.label ?? titleCase(active.name)) : '';

// ThemingWidget supports a "system" mode, but the docs host doesn't yet which results in an inconsistent behavior.
// const const MODES: ThemeMode[] = ['light', 'dark', 'system'];
const MODES: ThemeMode[] = ['light', 'dark'];

// The env var is free-form text, so an unrecognized value falls back to 'light'
// instead of reaching the markup as a bogus `data-mode`.
const requestedMode = modeProp ?? env.defaultSampleMode;
const mode: ThemeMode = MODES.includes(requestedMode as ThemeMode)
  ? (requestedMode as ThemeMode)
  : 'light';

const modeLabels: Record<ThemeMode, string> = {
  light: 'Light',
  dark: 'Dark',
  system: 'System',
};
---

<div
  class:list={['igd-theming', className]}
  id={rootId}
  data-target={target}
  data-mode={mode}
  data-resolved-mode={mode === 'system' ? undefined : mode}
  data-theme={active?.name}
>
  <button
    type="button"
    class="igd-theming__trigger"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={label}
  >
    <span class="igd-theming__swatch" data-swatch>
      {active?.swatch.map((c) => <span class="igd-theming__dot" style={`--dot: ${c}`} />)}
    </span>
    <span class="igd-theming__value">
      <span class="igd-theming__theme-name" data-theme-name>{activeLabel}</span>
      {
        showMode && (
          <span class="igd-theming__mode-name" data-mode-name>
            {modeLabels[mode === 'system' ? 'light' : mode]}
          </span>
        )
      }
    </span>
    <svg
      class="igd-theming__chevron"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M6 9l6 6 6-6"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div class="igd-theming__panel" role="dialog" hidden>
    {
      showMode && (
        <div class="igd-theming__mode-row">
          <span class="igd-theming__section-label">Mode</span>
          <div class="igd-theming__mode-buttons" role="group" aria-label="Color mode">
            {MODES.map((m) => (
              <button
                type="button"
                class="igd-theming__mode-btn"
                data-mode-btn={m}
                aria-pressed={m === mode ? 'true' : 'false'}
                aria-label={modeLabels[m]}
                title={modeLabels[m]}
              >
                {m === 'light' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
                    <path
                      d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                )}
                {m === 'dark' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
                {m === 'system' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect
                      x="3"
                      y="4"
                      width="18"
                      height="12"
                      rx="1.5"
                      stroke="currentColor"
                      stroke-width="2"
                    />
                    <path
                      d="M8 20h8M12 16v4"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                )}
              </button>
            ))}
          </div>
        </div>
      )
    }

    <ul class="igd-theming__list" role="listbox" aria-label={label}>
      {
        themes.map((t) => {
          const name = t.label ?? titleCase(t.name);
          const isActive = t.name === active?.name;
          return (
            <li>
              <button
                type="button"
                class="igd-theming__option"
                role="option"
                aria-selected={isActive ? 'true' : 'false'}
                data-option={t.name}
                data-label={name}
                data-swatch={t.swatch.join(',')}
              >
                <span class="igd-theming__swatch">
                  {t.swatch.map((c) => (
                    <span class="igd-theming__dot" style={`--dot: ${c}`} />
                  ))}
                </span>
                <span class="igd-theming__option-name">{name}</span>
                <svg
                  class="igd-theming__check"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M5 13l4 4L19 7"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<script>
  class IgdThemingWidget {
    private root: HTMLElement;
    private trigger: HTMLButtonElement;
    private panel: HTMLElement;
    /** Whether the panel was promoted to a top-layer popover. */
    private usePopover: boolean;
    private reposition = () => this.position();
    /** Backs the `system` mode: the OS color-scheme preference. */
    private scheme = window.matchMedia('(prefers-color-scheme: dark)');
    private onSchemeChange = () => {
      // Only `system` tracks the OS; an explicit light/dark choice is fixed.
      if (this.preference !== 'system') return;
      this.applyResolvedMode();
      this.emit();
    };

    constructor(root: HTMLElement) {
      this.root = root;
      this.trigger = root.querySelector('.igd-theming__trigger') as HTMLButtonElement;
      this.panel = root.querySelector('.igd-theming__panel') as HTMLElement;

      // Promote to the top layer so ancestors that clip (the sample container
      // uses `overflow: hidden`) or create a stacking context can't swallow the
      // panel. `manual` — not `auto` — because light dismiss and Escape are
      // already handled below, and `auto` would also close the panel on the
      // very click that opened it.
      this.usePopover = typeof this.panel.showPopover === 'function';
      if (this.usePopover) {
        this.panel.setAttribute('popover', 'manual');
        // A closed popover is `display: none` by UA style, so the `hidden`
        // attribute (the no-JS fallback) is no longer needed and would win.
        this.panel.hidden = false;
      }

      this.bind();

      // Turn a `system` selection into a concrete mode now, and keep following
      // the OS for as long as it stays selected.
      this.applyResolvedMode();
      this.scheme.addEventListener('change', this.onSchemeChange);
    }

    private bind() {
      this.trigger.addEventListener('click', () => this.toggle());

      this.root.querySelectorAll<HTMLElement>('.igd-theming__option').forEach((opt) => {
        opt.addEventListener('click', () => {
          this.selectTheme(opt, true);
          this.close();
        });
      });

      this.root.querySelectorAll<HTMLElement>('.igd-theming__mode-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          this.selectMode(btn.dataset.modeBtn || 'light', true);
        });
      });

      document.addEventListener('click', (e) => {
        if (!this.root.contains(e.target as Node)) this.close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen()) {
          this.close();
          this.trigger.focus();
        }
      });
    }

    private isOpen() {
      return this.trigger.getAttribute('aria-expanded') === 'true';
    }

    private toggle() {
      if (this.isOpen()) {
        this.close();
      } else {
        this.open();
      }
    }

    private open() {
      this.trigger.setAttribute('aria-expanded', 'true');
      if (this.usePopover) {
        this.panel.showPopover();
      } else {
        this.panel.hidden = false;
      }
      this.root.classList.add('is-open');
      this.position();
      // The trigger can live inside a scrolling container (or the page itself
      // can scroll), so follow it for as long as the panel is open. Capture
      // phase catches scrolls on any ancestor, not just the document.
      window.addEventListener('scroll', this.reposition, { capture: true, passive: true });
      window.addEventListener('resize', this.reposition, { passive: true });
    }

    private close() {
      this.trigger.setAttribute('aria-expanded', 'false');
      if (this.usePopover) {
        if (this.panel.matches(':popover-open')) this.panel.hidePopover();
      } else {
        this.panel.hidden = true;
      }
      this.root.classList.remove('is-open', 'is-above');
      window.removeEventListener('scroll', this.reposition, { capture: true });
      window.removeEventListener('resize', this.reposition);
    }

    /**
     * Place the panel below the trigger, or above it when the space below is
     * too small and there is more room above. When neither side fits the full
     * panel, the taller side wins and the panel is capped with a `max-height`
     * (the list scrolls) so it always stays inside the viewport.
     */
    private position() {
      if (!this.isOpen()) return;

      const GAP = 4; // matches the CSS offset of the fallback panel
      const EDGE = 8; // keep this much clearance from the viewport edges

      const anchor = this.trigger.getBoundingClientRect();
      this.panel.style.maxHeight = '';
      const height = this.panel.offsetHeight;

      const roomBelow = window.innerHeight - anchor.bottom - GAP - EDGE;
      const roomAbove = anchor.top - GAP - EDGE;
      const above = height > roomBelow && roomAbove > roomBelow;

      const available = above ? roomAbove : roomBelow;
      if (height > available) this.panel.style.maxHeight = `${Math.max(available, 96)}px`;
      this.root.classList.toggle('is-above', above);

      if (!this.usePopover) return;

      // Top-layer popovers are positioned against the viewport, so the
      // trigger's viewport rect can be used directly.
      const shown = this.panel.offsetHeight; // post-cap height
      const top = above ? Math.max(EDGE, anchor.top - GAP - shown) : anchor.bottom + GAP;
      const maxLeft = window.innerWidth - this.panel.offsetWidth - EDGE;
      const left = Math.max(EDGE, Math.min(anchor.left, maxLeft));

      this.panel.style.top = `${top}px`;
      this.panel.style.left = `${left}px`;
    }

    private selectTheme(opt: HTMLElement, emit: boolean) {
      const name = opt.dataset.option || '';
      const label = opt.dataset.label || name;
      const swatch = (opt.dataset.swatch || '').split(',').filter(Boolean);

      this.root
        .querySelectorAll('.igd-theming__option')
        .forEach((o) => o.setAttribute('aria-selected', 'false'));
      opt.setAttribute('aria-selected', 'true');

      const nameEl = this.trigger.querySelector('[data-theme-name]');
      if (nameEl) nameEl.textContent = label;

      const swatchEl = this.trigger.querySelector('[data-swatch]');
      if (swatchEl) {
        swatchEl.innerHTML = swatch
          .map((c) => `<span class="igd-theming__dot" style="--dot: ${c}"></span>`)
          .join('');
      }

      this.root.dataset.theme = name;
      this.reflect();
      if (emit) this.emit();
    }

    /** The user's selection: `light`, `dark` or `system`. */
    private get preference() {
      return this.root.dataset.mode || 'light';
    }

    /** The concrete mode that selection maps to: `light` or `dark`. */
    private get resolvedMode() {
      const pref = this.preference;
      if (pref === 'system') return this.scheme.matches ? 'dark' : 'light';
      return pref === 'dark' ? 'dark' : 'light';
    }

    /**
     * Publish the resolved mode on the root — so consumers that read the DOM
     * instead of listening (the sample widget does, when its iframe loads) get
     * a concrete value — and push it out to the `target` elements.
     */
    private applyResolvedMode() {
      const resolved = this.resolvedMode;
      this.root.dataset.resolvedMode = resolved;

      // The trigger names the mode the sample actually renders in, so `system`
      // reads as "Light" / "Dark" there — the selection itself stays visible
      // through the pressed state of the mode buttons.
      const modeNameEl = this.trigger.querySelector('[data-mode-name]');
      if (modeNameEl) {
        modeNameEl.textContent = resolved.charAt(0).toUpperCase() + resolved.slice(1);
      }

      this.reflect();
    }

    private selectMode(mode: string, emit: boolean) {
      this.root.querySelectorAll<HTMLElement>('.igd-theming__mode-btn').forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.modeBtn === mode ? 'true' : 'false');
      });
      this.root.dataset.mode = mode;

      this.applyResolvedMode();
      if (emit) this.emit();
    }

    private reflect() {
      const sel = this.root.dataset.target;
      if (!sel) return;
      document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
        el.dataset.igdTheme = this.root.dataset.theme || '';
        el.dataset.igdMode = this.root.dataset.resolvedMode || '';
      });
    }

    private emit() {
      const detail = {
        theme: this.root.dataset.theme,
        // Concrete, so consumers never have to resolve `system` themselves...
        mode: this.root.dataset.resolvedMode,
        // ...while the raw selection stays available for mirroring the UI.
        modePreference: this.root.dataset.mode,
      };
      this.root.dispatchEvent(new CustomEvent('igd-theme-change', { detail, bubbles: true }));
    }
  }

  function initThemingWidgets() {
    document.querySelectorAll<HTMLElement>('.igd-theming').forEach((el) => {
      if ((el as HTMLElement & { _igdInit?: boolean })._igdInit) return;
      (el as HTMLElement & { _igdInit?: boolean })._igdInit = true;
      new IgdThemingWidget(el);
    });
  }

  document.addEventListener('astro:page-load', initThemingWidgets);
  initThemingWidgets();
</script>

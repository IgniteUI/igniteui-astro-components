---
/**
 * GlobalNavBar
 *
 * Renders the IG global navigation bar directly in the light DOM.
 *
 * CDN styles/scripts for each platform are already injected into <head> by
 * getPlatformHead() in astro.config.ts — not repeated here.
 */
import { fetchIgNav } from '../../lib/nav-helpers.ts';
import styles from './GlobalNavBar.module.scss';
import type { NavLang } from '../../platform.ts';

interface Props {
  lang: NavLang;
}

const { lang } = Astro.props as Props;

const resolvedLang = lang;

// Fetch nav HTML directly (cached per locale per build).
const igNav = await fetchIgNav(resolvedLang);
---

{
  /* ============================================================
    IG-family global nav (angular, react, blazor, web-components,
    slingshot, igniteui)
    ============================================================ */
}
<div class={styles.navBar} transition:persist="global-nav-bar">
  {/* IG nav — fetched directly via fetchIgNav(); falls back to static markup */}
  {igNav?.prefetched && <Fragment set:html={igNav.headerHtml} />}
</div>

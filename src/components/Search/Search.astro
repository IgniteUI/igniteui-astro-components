---
/**
 * Search
 *
 * Pagefind-powered full-text search modal.
 * The search index (/pagefind/) is generated by `pagefind --site <outDir>`
 * at the end of every production build (wired in siteMetaIntegration).
 *
 * In development the button is rendered but the dynamic import will 404
 * gracefully — no errors surface to the user.
 */
import './Search.scss';
---

<div class="search-decoration">
    <igc-icon-button
        class="search-trigger-mobile"
        variant="flat"
        aria-label="Search documentation"
        aria-haspopup="dialog"
        aria-controls="search-dialog"
    >
        <igc-icon name="search" collection="docs" aria-hidden="true"></igc-icon>
    </igc-icon-button>
    <igc-input
        id="search-trigger"
        class="search-trigger"
        type="text"
        placeholder="Search"
        readonly
        role="button"
        aria-haspopup="dialog"
        aria-controls="search-dialog"
        aria-label="Search documentation"
        title="Search (Ctrl+K)"
    >
        <igc-icon name="search" collection="docs" slot="prefix" aria-hidden="true"></igc-icon>
        <kbd class="search-trigger__hint" slot="suffix" style="display:none;"><kbd>Ctrl</kbd><kbd>K</kbd></kbd>
    </igc-input>
</div>

<igc-dialog id="search-dialog" class="igd-search-dialog" aria-label="Search" hide-default-action close-on-outside-click>
    <div class="igd-search-shell">
        <header class="igd-search-header">
            <igc-input
                type="text"
                class="igd-search-input"
                placeholder="Search documentation"
                autocomplete="off"
                outlined
                aria-label="Search documentation"
            >
                <igc-icon class="igd-search-icon" name="search" collection="docs" slot="prefix" aria-hidden="true"></igc-icon>
                <igc-icon-button
                    slot="suffix"
                    class="igd-search-clear"
                    variant="flat"
                    type="button"
                    aria-label="Clear search"
                    name="clear"
                    collection="docs"
                    hidden
                ></igc-icon-button>
            </igc-input>
        </header>
        <div class="igd-search-content">
            <div class="igd-search-status" aria-live="polite"></div>
            <igc-list class="igd-search-results" hidden></igc-list>
            <igc-button class="igd-search-more-btn" variant="flat" type="button" hidden>
                Show more results
            </igc-button>
        </div>
        <footer class="igd-search-footer">
            <igc-button class="search-close" variant="outlined">
                Close
            </igc-button>
        </footer>
    </div>
</igc-dialog>

<script>
  import {
    defineComponents,
    IgcIconComponent,
    IgcIconButtonComponent,
    IgcButtonComponent,
    IgcDialogComponent,
    IgcInputComponent,
    IgcListComponent,
    IgcListItemComponent,
    IgcDividerComponent,
  } from 'igniteui-webcomponents';
  import '../../scripts/icon-registry';

  defineComponents(
    IgcIconComponent,
    IgcIconButtonComponent,
    IgcButtonComponent,
    IgcDialogComponent,
    IgcInputComponent,
    IgcListComponent,
    IgcListItemComponent,
    IgcDividerComponent,
  );

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const _w   = window as any;

  const SEARCH_DEBOUNCE_MS = 200;
  const MIN_QUERY_LEN      = 2;    // 1 char matches (and whole-word-highlights) everything
  const PAGE_SIZE          = 10;   // results shown per display page
  const SCAN_BATCH         = 20;   // raw results fetched per phrase-filter pass

  // Bumped per query; runSearch/renderNextPage bail after each await if it changed,
  // so a slow query can't overwrite a newer one.
  let searchSeq = 0;

  // Pagination state for the active query. The phrase filter runs client-side, so
  // we scan Pagefind's lazy handles (pfResults) in batches, keep the phrase matches
  // (matches), and page the display over those. rawConsumed counts handles scanned,
  // displayed counts matches rendered.
  let activeSeq      = 0;
  let activeTerm     = '';
  let activeTokens: string[] = [];
  let pfResults: any[] = [];
  let rawConsumed    = 0;
  let matches: any[] = [];
  let displayed      = 0;
  let loadingMore    = false;

  // Cache the promise so concurrent first callers share one import/options/init.
  function loadPagefind(): Promise<any> {
    if (_w.__pagefindPromise) return _w.__pagefindPromise;
    _w.__pagefindPromise = (async () => {
      try {
        const pf = await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`);
        // Must run before init(). Tuned so keyword-dense API pages don't bury prose.
        await pf.options?.({
          ranking: {
            termSaturation: 1.0,   // default 1.4
            pageLength:     0.6,   // default 0.75
            termFrequency:  1.0,
            termSimilarity: 1.0,
          },
        });
        await pf.init();
        return pf;
      } catch {
        return null;
      }
    })();
    return _w.__pagefindPromise;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // Keep a result only if it actually contains what was typed: some highlighted
  // word must start with one of the query tokens. This rejects Pagefind's prefix
  // fallback — a gibberish query like "asdaasd…" matching the bare "as" on nearly
  // every page — while still allowing as-you-type matches ("grid" finds "gridlines").
  // No body highlights means the match was in the title/meta, which we keep.
  function looksRelevant(excerpt: string, queryTokens: string[]): boolean {
    if (queryTokens.length === 0) return true;
    const marks = [...excerpt.matchAll(/<mark[^>]*>([\s\S]*?)<\/mark>/gi)]
      .map((m) => m[1].replace(/<[^>]+>/g, '').replace(/[^a-z0-9]/gi, '').toLowerCase())
      .filter(Boolean);
    if (marks.length === 0) return true;
    return marks.some((h) => queryTokens.some((t) => h.startsWith(t)));
  }

  // Pagefind highlights the whole matched word; trim each <mark> down to just the
  // typed portion so only what the user typed is highlighted ("config" stays a
  // prefix of <mark>config</mark>uration). Marks whose word isn't one of the typed
  // tokens (e.g. a stem match) are left whole.
  function trimHighlights(excerpt: string): string {
    if (!activeTokens.length) return excerpt;
    return excerpt.replace(/<mark[^>]*>([\s\S]*?)<\/mark>/gi, (full: string, word: string) => {
      const lower = word.toLowerCase();
      let keep = 0;
      for (const t of activeTokens) if (t.length > keep && lower.startsWith(t)) keep = t.length;
      return keep === 0 || keep >= word.length
        ? full
        : `<mark>${word.slice(0, keep)}</mark>${word.slice(keep)}`;
    });
  }

  /** HTML for a single result row from its resolved Pagefind data. */
  function renderResultItem(r: any): string {
    const title = escapeHtml(r.meta?.title ?? r.url);
    const path  = r.meta?.breadcrumb ? escapeHtml(r.meta.breadcrumb) : '';
    return `<igc-list-item>
      <a href="${escapeHtml(r.url)}" class="igd-search-link">
        <span class="igd-search-result-title">${title}</span>
        ${path ? `<span class="igd-search-result-path">${path}</span>` : ''}
        <span class="igd-search-result-excerpt">${trimHighlights(r.excerpt ?? '')}</span>
      </a>
    </igc-list-item>`;
  }

  // Render the empty state for the active query.
  function showNoResults() {
    const statusEl = document.querySelector<HTMLElement>('.igd-search-status');
    const listEl   = document.querySelector<any>('igc-list.igd-search-results');
    const moreBtn  = document.querySelector<any>('.igd-search-more-btn');
    if (statusEl) statusEl.innerHTML = `<span class="igd-no-results">No results for <strong class="igd-search-query">${escapeHtml(activeTerm)}.</strong></span>`;
    if (listEl) { listEl.innerHTML = ''; listEl.hidden = true; }
    if (moreBtn) moreBtn.hidden = true;
  }

  // Scan raw Pagefind handles in batches, keeping the relevant matches, until there
  // is at least one unshown display page or all raw results are scanned. Throws if
  // a data() fetch rejects.
  async function ensureMatches(seq: number) {
    while (matches.length - displayed < PAGE_SIZE && rawConsumed < pfResults.length) {
      const slice = pfResults.slice(rawConsumed, rawConsumed + SCAN_BATCH);
      const data  = await Promise.all(slice.map((r: any) => r.data()));
      if (seq !== searchSeq) return;
      rawConsumed += slice.length;
      matches.push(...data.filter((r: any) => looksRelevant(r.excerpt ?? '', activeTokens)));
    }
  }

  // Append the next page of phrase-matching results, fetching more raw batches as
  // needed. seq ties the work to its query so a stale page can't render.
  async function renderNextPage(seq: number, isFirst = false) {
    const statusEl = document.querySelector<HTMLElement>('.igd-search-status');
    const listEl   = document.querySelector<any>('igc-list.igd-search-results');
    const moreBtn  = document.querySelector<any>('.igd-search-more-btn');
    if (!statusEl || !listEl) return;

    if (seq !== searchSeq || loadingMore) return;
    if (displayed >= matches.length && rawConsumed >= pfResults.length) {   // nothing more to show
      if (isFirst) showNoResults();
      return;
    }

    loadingMore = true;
    try {
      await ensureMatches(seq);
    } catch {
      if (seq === searchSeq) statusEl.textContent = 'Failed to load search results.';
      return;                                 // finally still clears loadingMore
    } finally {
      loadingMore = false;
    }
    if (seq !== searchSeq) return;            // user typed more while data() resolved

    const slice = matches.slice(displayed, displayed + PAGE_SIZE);
    if (slice.length === 0) {                 // scanned all raw, nothing matched
      if (isFirst) showNoResults();
      if (moreBtn) moreBtn.hidden = true;
      return;
    }
    displayed += slice.length;
    listEl.insertAdjacentHTML('beforeend', slice.map(renderResultItem).join(''));
    listEl.hidden = false;

    const total = pfResults.length;
    const more = displayed < matches.length || rawConsumed < pfResults.length;
    statusEl.textContent = more
      ? `Showing ${displayed} of ${total} results`
      : `${displayed} result${displayed === 1 ? '' : 's'}`;
    if (moreBtn) moreBtn.hidden = !more;
  }

  async function runSearch(query: string) {
    const statusEl = document.querySelector<HTMLElement>('.igd-search-status');
    const listEl   = document.querySelector<any>('igc-list.igd-search-results');
    const clearBtn = document.querySelector<any>('.igd-search-clear');
    const moreBtn  = document.querySelector<any>('.igd-search-more-btn');
    const input    = document.querySelector<any>('igc-input.igd-search-input');

    if (!statusEl || !listEl) return;

    if (clearBtn) clearBtn.hidden = !query;
    input?.requestUpdate?.();

    const term = query.trim();
    if (!term) {
      searchSeq++;   // invalidate any in-flight search so a late result can't repopulate
      statusEl.textContent = '';
      listEl.innerHTML     = '';
      listEl.hidden        = true;
      if (moreBtn) moreBtn.hidden = true;
      return;
    }

    if (term.length < MIN_QUERY_LEN) {
      searchSeq++;   // cancel any in-flight search
      statusEl.textContent = `Type at least ${MIN_QUERY_LEN} characters to search.`;
      listEl.innerHTML     = '';
      listEl.hidden        = true;
      if (moreBtn) moreBtn.hidden = true;
      return;
    }

    const seq = ++searchSeq;
    statusEl.textContent = 'Searching…';

    const pf = await loadPagefind();
    if (seq !== searchSeq) return;            // superseded while loading the index
    if (!pf) {
      statusEl.textContent = 'Search index not available — run a production build first.';
      return;
    }

    pf.preload?.(term);   // warm the index chunks during the debounce window

    // debouncedSearch returns null when superseded; search() is a fallback for old bundles.
    const search = typeof pf.debouncedSearch === 'function'
      ? await pf.debouncedSearch(term, undefined, SEARCH_DEBOUNCE_MS)
      : await pf.search(term);
    if (search === null) return;
    if (seq !== searchSeq) return;

    // New result set — reset pagination and render the first page.
    activeSeq     = seq;
    activeTerm    = term;
    pfResults     = search.results;
    activeTokens  = term.toLowerCase().match(/[a-z0-9]+/g) ?? [];
    rawConsumed   = 0;
    matches       = [];
    displayed     = 0;
    listEl.innerHTML = '';

    await renderNextPage(seq, true);
  }

  // Infinite scroll. Bound to both candidates since either may be the real
  // scroll container; the one that doesn't scroll never fires. Bind-once flag.
  function attachInfiniteScroll() {
    const NEAR_BOTTOM_PX = 200;
    const onScroll = (e: Event) => {
      const el = e.currentTarget as HTMLElement;
      if (el.scrollTop + el.clientHeight >= el.scrollHeight - NEAR_BOTTOM_PX) {
        renderNextPage(activeSeq);
      }
    };
    ['.igd-search-content', 'igc-list.igd-search-results'].forEach((sel) => {
      const el = document.querySelector<any>(sel);
      if (!el || el.__infiniteBound) return;
      el.__infiniteBound = true;
      el.addEventListener('scroll', onScroll, { passive: true });
    });
  }

  async function openSearch() {
    const dialog = document.querySelector<any>('igc-dialog.igd-search-dialog');
    if (!dialog) return;
    const sw = window.innerWidth - document.documentElement.clientWidth;
    if (sw) document.body.style.paddingRight = `${sw}px`;
    document.body.toggleAttribute('data-search-modal-open', true);
    await dialog.show();
    loadPagefind();
    attachInfiniteScroll();
    requestAnimationFrame(() => {
      document.querySelector<any>('igc-input.igd-search-input')?.focus();
    });
  }

  if (!_w.__searchListeners) {
    _w.__searchListeners = true;

    document.addEventListener('igcClosed', (e: Event) => {
      if ((e.target as Element).matches('igc-dialog.igd-search-dialog')) {
        document.body.toggleAttribute('data-search-modal-open', false);
        document.body.style.paddingRight = '';
      }
    });

    function updateSearchHint() {
      const hint = document.querySelector<HTMLElement>('kbd.search-trigger__hint');
      if (!hint) return;
      const isMac = /Mac|iPhone|iPod|iPad/i.test(navigator.userAgent);
      const modKey = hint.querySelector('kbd');
      if (modKey) modKey.textContent = isMac ? '⌘' : 'Ctrl';
      const btn = document.getElementById('search-trigger');
      btn?.setAttribute('aria-keyshortcuts', isMac ? 'Meta+K' : 'Control+K');
      btn?.setAttribute('title',             isMac ? 'Search (⌘K)' : 'Search (Ctrl+K)');
      hint.style.display = '';
    }
    updateSearchHint();

    document.addEventListener('click', (e: Event) => {
      if ((e.target as Element).closest('#search-trigger') || (e.target as Element).closest('.search-trigger-mobile')) openSearch();
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.key === 'Enter' || e.key === ' ') && document.activeElement?.id === 'search-trigger') {
        e.preventDefault();
        openSearch();
      }
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        const dialog = document.querySelector<any>('igc-dialog.igd-search-dialog');
        if (dialog?.open) dialog.hide(); else openSearch();
      }
    });

    document.addEventListener('astro:page-load', () => {
      document.querySelector<any>('igc-dialog.igd-search-dialog')?.hide();
      updateSearchHint();
    });

    document.addEventListener('igcInput', (e: Event) => {
      if (!(e.target as Element).closest('igc-input.igd-search-input')) return;
      const val = (document.querySelector<any>('igc-input.igd-search-input')?.value as string) ?? '';
      // Debouncing + supersession are handled inside runSearch via debouncedSearch.
      runSearch(val);
    });

    document.addEventListener('click', (e: Event) => {
      const target = e.target as Element;
      if (target.closest('.igd-search-clear')) {
        const input = document.querySelector<any>('igc-input.igd-search-input');
        if (!input) return;
        input.value = '';
        input.focus();
        runSearch('');
      } else if (target.closest('.search-close')) {
        document.querySelector<any>('igc-dialog.igd-search-dialog')?.hide();
      } else if (target.closest('.igd-search-more-btn')) {
        renderNextPage(activeSeq);
      } else if (target.closest('.igd-search-shell') && target.closest('a[href]')) {
        document.querySelector<any>('igc-dialog.igd-search-dialog')?.hide();
      }
    });
  }
</script>

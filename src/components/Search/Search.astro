---
/**
 * Search
 *
 * Pagefind-powered full-text search modal.
 * The search index (/pagefind/) is generated by `pagefind --site <outDir>`
 * at the end of every production build (wired in siteMetaIntegration).
 *
 * In development the button is rendered but the dynamic import will 404
 * gracefully — no errors surface to the user.
 */
import './Search.scss';
---

<button
    id="search-trigger"
    class="search-trigger"
    aria-label="Search documentation"
    title="Search (Ctrl+K)"
>
    <igc-icon name="search" collection="docs" aria-hidden="true"></igc-icon>
    <span class="search-trigger__label">Search</span>
    <kbd class="search-trigger__hint" style="display:none;"><kbd>Ctrl</kbd><kbd>K</kbd></kbd>
</button>

<igc-dialog id="search-dialog" class="igd-search-dialog" aria-label="Search" hide-default-action close-on-outside-click>
    <div class="igd-search-shell">
        <header class="igd-search-header">
            <igc-input
                type="text"
                class="igd-search-input"
                placeholder="Search documentation"
                autocomplete="off"
                outlined
                aria-label="Search documentation"
            >
                <igc-icon class="igd-search-icon" name="search" collection="docs" slot="prefix" aria-hidden="true"></igc-icon>
                <igc-icon-button
                    slot="suffix"
                    class="igd-search-clear"
                    variant="flat"
                    type="button"
                    aria-label="Clear search"
                    name="clear"
                    collection="docs"
                    hidden
                ></igc-icon-button>
            </igc-input>
            <button
                type="button"
                class="search-trigger search-close"
                aria-label="Close search"
            >
                <igc-icon name="close" collection="docs" aria-hidden="true"></igc-icon>
            </button>
        </header>
        <igc-divider></igc-divider>
        <div class="igd-search-status" aria-live="polite"></div>
        <igc-list class="igd-search-results" hidden></igc-list>
    </div>
</igc-dialog>

<script>
  import {
    defineComponents,
    IgcIconComponent,
    IgcIconButtonComponent,
    IgcDialogComponent,
    IgcInputComponent,
    IgcListComponent,
    IgcListItemComponent,
    IgcDividerComponent,
  } from 'igniteui-webcomponents';
  import '../../scripts/icon-registry';

  defineComponents(
    IgcIconComponent,
    IgcIconButtonComponent,
    IgcDialogComponent,
    IgcInputComponent,
    IgcListComponent,
    IgcListItemComponent,
    IgcDividerComponent,
  );

  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const _w   = window as any;

  const INPUT_DEBOUNCE_MS = 150;
  const MAX_RESULTS       = 10;

  async function loadPagefind() {
    if (_w.__pagefind) return _w.__pagefind;
    try {
      const pf = await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`);
      await pf.init();
      _w.__pagefind = pf;
      return pf;
    } catch {
      return null;
    }
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  async function runSearch(query: string) {
    const statusEl = document.querySelector<HTMLElement>('.igd-search-status');
    const listEl   = document.querySelector<any>('igc-list.igd-search-results');
    const clearBtn = document.querySelector<any>('.igd-search-clear');
    const input    = document.querySelector<any>('igc-input.igd-search-input');

    if (!statusEl || !listEl) return;

    if (clearBtn) clearBtn.hidden = !query;
    input?.requestUpdate?.();

    if (!query.trim()) {
      statusEl.textContent = '';
      listEl.innerHTML     = '';
      listEl.hidden        = true;
      return;
    }

    statusEl.textContent = 'Searching…';

    const pf = await loadPagefind();
    if (!pf) {
      statusEl.textContent = 'Search index not available — run a production build first.';
      return;
    }

    const search  = await pf.search(query.trim());
    const results = await Promise.all(
      search.results.slice(0, MAX_RESULTS).map((r: any) => r.data()),
    );

    if (results.length === 0) {
      statusEl.innerHTML = `No results for “<strong class="igd-search-query">${escapeHtml(query)}</strong>”.`;
      listEl.innerHTML   = '';
      listEl.hidden      = true;
      return;
    }

    const total = search.results.length;
    statusEl.textContent = total > MAX_RESULTS
      ? `Showing ${MAX_RESULTS} of ${total} results`
      : `${total} result${total === 1 ? '' : 's'}`;
    listEl.innerHTML = results.map((r: any) => `<igc-list-item>
      <a href="${escapeHtml(r.url)}" class="igd-search-link">
        <span class="igd-search-result-title">${escapeHtml(r.meta?.title ?? r.url)}</span>
        <span class="igd-search-result-excerpt">${r.excerpt ?? ''}</span>
      </a>
    </igc-list-item>`).join('');
    listEl.hidden = false;
  }

  async function openSearch() {
    const dialog = document.querySelector<any>('igc-dialog.igd-search-dialog');
    if (!dialog) return;
    await dialog.show();
    loadPagefind();
    requestAnimationFrame(() => {
      document.querySelector<any>('igc-input.igd-search-input')?.focus();
    });
  }

  if (!_w.__searchListeners) {
    _w.__searchListeners = true;

    function updateSearchHint() {
      const hint = document.querySelector<HTMLElement>('kbd.search-trigger__hint');
      if (!hint) return;
      const isMac = /Mac|iPhone|iPod|iPad/i.test(navigator.userAgent);
      const modKey = hint.querySelector('kbd');
      if (modKey) modKey.textContent = isMac ? '⌘' : 'Ctrl';
      const btn = document.getElementById('search-trigger');
      btn?.setAttribute('aria-keyshortcuts', isMac ? 'Meta+K' : 'Control+K');
      btn?.setAttribute('title',             isMac ? 'Search (⌘K)' : 'Search (Ctrl+K)');
      hint.style.display = '';
    }
    updateSearchHint();

    document.getElementById('search-trigger')?.addEventListener('click', () => openSearch());

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        const dialog = document.querySelector<any>('igc-dialog.igd-search-dialog');
        if (dialog?.open) dialog.hide(); else openSearch();
      }
    });

    document.addEventListener('astro:page-load', () => {
      document.querySelector<any>('igc-dialog.igd-search-dialog')?.hide();
      updateSearchHint();
    });

    let debounceTimer: ReturnType<typeof setTimeout> | null = null;
    document.querySelector('igc-input.igd-search-input')?.addEventListener('igcInput', () => {
      if (debounceTimer !== null) clearTimeout(debounceTimer);
      const val = (document.querySelector<any>('igc-input.igd-search-input')?.value as string) ?? '';
      debounceTimer = setTimeout(() => runSearch(val), INPUT_DEBOUNCE_MS);
    });

    document.querySelector('.igd-search-clear')?.addEventListener('click', () => {
      const input = document.querySelector<any>('igc-input.igd-search-input');
      if (!input) return;
      input.value = '';
      input.focus();
      runSearch('');
    });

    document.querySelector('.igd-search-shell .search-close')?.addEventListener('click', () => {
      document.querySelector<any>('igc-dialog.igd-search-dialog')?.hide();
    });

    document.querySelector('.igd-search-shell')?.addEventListener('click', (e: Event) => {
      if ((e.target as Element).closest('a[href]')) {
        document.querySelector<any>('igc-dialog.igd-search-dialog')?.hide();
      }
    });
  }
</script>

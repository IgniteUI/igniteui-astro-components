---
import './DocsAside.scss';

interface Props {
  type?: 'note' | 'tip' | 'warning' | 'danger';
  title?: string;
  color?: string;
  class?: string;
  /** Override icon name from the 'docs' collection. */
  icon?: string;
}

const { type = 'note', title, color, icon, class: className } = Astro.props;

const defaultLabels: Record<string, string> = {
  note: 'Note',
  tip: 'Tip',
  warning: 'Warning',
  danger: 'Danger',
};

const defaultIcons: Record<string, string> = {
  note: 'info',
  tip: 'rocket',
  warning: 'warning',
  danger: 'warning',
};

const label = title ?? defaultLabels[type];
const resolvedIcon = icon !== undefined ? icon : defaultIcons[type];
const inlineStyle = color ? `--aside-color: ${color};` : undefined;
---

<aside
  class:list={['aside', `aside--${type}`, className]}
  aria-label={label}
  style={inlineStyle}
>
  <p class="aside-title" aria-hidden="true">
    {resolvedIcon && <igc-icon class="aside-icon" name={resolvedIcon} collection="docs" aria-hidden="true"></igc-icon>}
    {label}
  </p>
  <section class="aside-content">
    <slot />
  </section>
</aside>

<script>
  import { defineComponents, IgcIconComponent } from 'igniteui-webcomponents';
  import '../../../scripts/icon-registry';

  defineComponents(IgcIconComponent);
</script>


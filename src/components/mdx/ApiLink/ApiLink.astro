---
/**
 * Inline API documentation link.
 *
 * TypeDoc links resolve against the compact api-docs ApiLink index. If the
 * index does not contain the requested symbol/member, it renders code text
 * instead of guessing a URL.
 *
 * All resolution logic lives in `api-link-index.ts` so it can be shared with
 * non-Astro callers (e.g. the LLM markdown generator in docs-template).
 */
import type { PlatformContext } from '../../../lib/types.ts';
import { resolveApiLink, type ApiLinkProps } from './api-link-index';
import './ApiLink.scss';

const ctx = Astro.locals.platformContext as PlatformContext;
const result = resolveApiLink(Astro.props as ApiLinkProps, ctx);
---
{result.renderLink
    ? <a href={result.url}>{result.code ? <code>{result.label}</code> : result.label}</a>
    : result.code ? <code>{result.label}</code> : result.label}

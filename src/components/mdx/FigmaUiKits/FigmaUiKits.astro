---
/** "Explore our free Figma UI kits" banner that links a topic to the Ignite UI kits in Figma. */
import { navLang } from 'virtual:docs-template/site-meta';
import figmaLogo from '../../../assets/icons/figma-logo.svg?raw';
import openLinkIcon from '../../../assets/icons/open-link-blank.svg?raw';
import { DEFAULT_FIGMA_UI_KITS, type FigmaUiKit } from './kits';
import './FigmaUiKits.scss';

interface Props {
  /**
   * One link per kit, in display order.
   * @default the Material, Fluent, Bootstrap and Indigo kits (`DEFAULT_FIGMA_UI_KITS`)
   */
  kits?: FigmaUiKit[];
  /**
   * Bold text before the links, the same at every width.
   * @default 'Explore our free Figma UI kits' (localized for jp / kr)
   */
  title?: string;
  /**
   * `'auto'` wraps to fit and uses the compact layout below 480px; `'compact'` always does.
   * @default 'auto'
   */
  variant?: 'auto' | 'compact';
  /** Extra class(es) for the container. */
  class?: string;
}

interface Text {
  title: string;
  kit: string;
  newTab: string;
}

const JAPANESE: Text = {
  title: '無料の Figma UI キットを見る',
  kit: 'Figma UI キット',
  newTab: '(新しいタブで開きます)',
};

const KOREAN: Text = {
  title: '무료 Figma UI 키트 살펴보기',
  kit: 'Figma UI 키트',
  newTab: '(새 탭에서 열림)',
};

// Default copy per site language; unknown languages use English.
const DEFAULT_TEXT: Record<string, Text> = {
  en: {
    title: 'Explore our free Figma UI kits',
    kit: 'Figma UI kit',
    newTab: '(opens in a new tab)',
  },
  jp: JAPANESE,
  ja: JAPANESE,
  kr: KOREAN,
  ko: KOREAN,
};

const lang = (navLang ?? Astro.currentLocale ?? 'en').toLowerCase();
const defaults = DEFAULT_TEXT[lang] ?? DEFAULT_TEXT.en;

const {
  kits = DEFAULT_FIGMA_UI_KITS,
  title = defaults.title,
  variant = 'auto',
  class: className,
} = Astro.props;

if (kits.length === 0) {
  throw new Error('<FigmaUiKits> requires at least one kit.');
}
for (const kit of kits) {
  if (!kit.label?.trim() || !kit.href?.trim()) {
    throw new Error('<FigmaUiKits> requires every kit to have a non-empty `label` and `href`.');
  }
}
---

<div class:list={['igd-figma-kits', className]} data-variant={variant}>
  <div class="igd-figma-kits__banner">
    <p class="igd-figma-kits__heading">
      <span class="igd-figma-kits__logo" aria-hidden="true" set:html={figmaLogo} />
      <span class="igd-figma-kits__text">
        <strong class="igd-figma-kits__title">{title}</strong>
      </span>
    </p>

    {/* role="list" keeps the list announced in Safari VoiceOver. */}
    <ul class="igd-figma-kits__list" role="list">
      {kits.map((kit) => (
        <li class="igd-figma-kits__item">
          <a class="igd-figma-kits__link" href={kit.href} target="_blank" rel="noopener noreferrer">
            {kit.label}
            <span class="igd-figma-kits__sr-only">
              {' '}
              {defaults.kit} {defaults.newTab}
            </span>
            <span class="igd-figma-kits__icon" aria-hidden="true" set:html={openLinkIcon} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

---
/**
 * Renders a framed image that illustrates the anatomy of a component.
 *
 * Usage:
 *   <Anatomy src="/images/anatomy/button.png" alt="Button anatomy: label, prefix icon, and suffix icon" />
 *
 * The frame is a light-gray, bordered canvas with internal padding. The image
 * inside can never exceed that padding — its max-width is 100% of the frame's
 * content box (the box inside the padding) and its height scales to keep the
 * aspect ratio. The frame is a centering grid, so an image smaller than the
 * frame sits centered rather than pinned to a corner.
 *
 * Accessibility: `alt` is required and propagates to the inner <img>. Anatomy
 * diagrams are informative, so the alt text should describe what the diagram
 * conveys (the parts it labels), not merely name the component. The <img> also
 * gets native lazy loading and async decoding.
 */
import './Anatomy.scss';

interface Props {
  /** The image URL. Required. */
  src: string;
  /**
   * The image's accessible description. Required — it becomes the inner
   * <img>'s `alt`. Describe the parts the diagram labels, e.g.
   * "Button anatomy: label text, optional prefix icon, optional suffix icon".
   */
  alt: string;
  /** Optional extra class(es) forwarded to the frame. */
  class?: string;
}

const { src, alt, class: className } = Astro.props;

if (!src?.trim()) {
  throw new Error('<Anatomy> requires a `src` (image URL).');
}
// Anatomy diagrams are informative, not decorative — an absent, empty or
// whitespace-only alt would hide the diagram's meaning from screen-reader
// users. Fail loudly in dev.
if (!alt?.trim()) {
  throw new Error(
    '<Anatomy> requires a non-empty `alt` describing the diagram for screen readers.',
  );
}
---

<figure class:list={['igd-anatomy', className]}>
  <img class="igd-anatomy__image" src={src} alt={alt} loading="lazy" decoding="async" />
</figure>

---
/**
 * Label-slot renderer for DocsTree's sidebar variant.
 *
 * Receives `{ node, depth, isLeaf, isActive }` from DocsTreeItem.
 * Branches on isLeaf:
 *   • leaf  → label text + optional badge (from node.meta.badge)
 *   • group → label text only (the caret lives in the native indicator slot of igc-tree-item)
 *
 * The outer container is the `<a class="docs-tree-link">` (leaves) or
 * `<div class="docs-tree-group">` (groups) provided by DocsTreeItem.
 * SidebarLabel only contributes the inner content.
 */
import type { TreeNode } from '../DocsTree/types';
import type { SidebarBadge } from '../../lib/sidebar/types';

interface Props {
  node: TreeNode;
  depth: number;
  isLeaf: boolean;
  isActive: boolean;
}

const { node, isLeaf } = Astro.props;
const badges = (node.meta?.badges ?? []) as SidebarBadge[];
---

{isLeaf ? (
  <>
    <div class="igd-lable-and-badge">
        <span class="docs-tree-label">{node.label}</span>
        {badges.map(b => <igc-badge class={`sidebar-badge ${b.variant}`}>{b.text}</igc-badge>)}
    </div>
  </>
) : (
  <span class="group-label-text">{node.label}</span>
)}

---
/**
 * Docs sidebar — composes the shared DocsTree base with the sidebar
 * filter custom element and a SidebarLabel renderer (badges + caret).
 *
 * Public Props are unchanged from the previous implementation.
 *
 * Package: igniteui-webcomponents (public, MIT) — change the import path
 * in the <script> block below to use @infragistics/igniteui-webcomponents.
 */
import {
  sidebar as sidebarData,
  trailingSlash as configuredTrailingSlash,
} from 'virtual:docs-template/site-meta';
import { platform as virtualPlatform } from 'virtual:docs-template/nav-html';
import SidebarFilterInput from './SidebarFilterInput.astro';
import './DocsSidebar.scss';
import SidebarLabel from './SidebarLabel.astro';
import DocsTree from '../DocsTree/DocsTree.astro';
import { toTreeNodes } from './toTreeNodes';
import type { SidebarEntry } from '../../lib/sidebar/types';
import { normalizeSlug } from '../../lib/sidebar/helpers';

interface Props {
  currentSlug?: string;
  /**
   * Sidebar tree to render. Overrides the virtual module value when provided.
   * Useful when consuming the component without `siteMetaIntegration`.
   */
  items?: SidebarEntry[];
  /** Show the filter input above the tree. Defaults to true. */
  showFilter?: boolean;
  /**
   * Append trailing slash to sidebar links.
   * Defaults to the value derived from the site's `trailingSlash` Astro config
   * (exposed via the virtual module). Falls back to `true` if not configured.
   */
  trailingSlash?: boolean;
  /** Logo text shown in the slide-in sidebar. Defaults to the current product family. */
  logoText?: string;
  /** Platform label shown below logoText (e.g. 'Angular'). Auto-detected from virtual module when omitted. */
  platformLabel?: string | null;
}

const PLATFORM_LABELS: Record<string, string> = {
  angular: 'Angular',
  react: 'React',
  blazor: 'Blazor',
  'web-components': 'Web Components',
  winui: 'WinUI',
  uno: 'Uno Platform',
};

const useTrailingSlash = configuredTrailingSlash !== 'never';
const {
  currentSlug = '',
  items: itemsProp,
  showFilter = true,
  trailingSlash = useTrailingSlash,
  logoText =
    virtualPlatform === 'winui' || virtualPlatform === 'uno' ? 'Ultimate UI' : 'Ignite UI',
  platformLabel = virtualPlatform ? (PLATFORM_LABELS[virtualPlatform] ?? null) : null,
} = Astro.props;
const items = (itemsProp ?? sidebarData) as SidebarEntry[];
const nodes = toTreeNodes(items, currentSlug, { trailingSlash });
const activeId = normalizeSlug(currentSlug);
---

<sidebar-filter class="docs-sidebar" id="docs-sidebar" data-no-results="No topics match">
  <div class="igd-sidebar-logo">
    {/* Keep as <span>, not <h1> — avoids competing with the page <h1> in search. */}
    <span class="igd-logo-text">{logoText}</span>
    {platformLabel && <span class="igd-logo__platform">for {platformLabel}</span>}
  </div>
  <div class="sidebar-gutter">
    {showFilter && <SidebarFilterInput />}
  </div>
  <div class="sidebar-scroll" data-sidebar-scroll>
    <DocsTree
      nodes={nodes}
      variant="sidebar"
      activeId={activeId}
      toggleNodeOnClick
      ariaLabel="Sidebar navigation"
      renderLabel={SidebarLabel}
    />
  </div>
</sidebar-filter>
<div class="docs-sidebar-backdrop" id="docs-sidebar-backdrop" aria-hidden="true"></div>

<script>
  // Register Ignite UI Web Components used by the sidebar filter input.
  // (DocsTree registers IgcTreeComponent / IgcTreeItemComponent itself.)
  // To use the licensed package, change the import to:
  //   import { ... } from '@infragistics/igniteui-webcomponents';
  import {
    defineComponents,
    IgcBadgeComponent,
    IgcInputComponent,
    IgcButtonComponent,
    IgcIconComponent,
  } from 'igniteui-webcomponents';

  defineComponents(IgcBadgeComponent, IgcInputComponent, IgcButtonComponent, IgcIconComponent);

  // Icons (sidebar-filter-search, sidebar-filter-clear) are registered via
  // the icon registry which picks up all SVGs from src/assets/icons/.
  import '../../scripts/icon-registry';

  import './sidebar-filter';

  // Close the sidebar overlay when the backdrop is clicked.
  document.addEventListener('click', (e) => {
    if ((e.target as Element | null)?.closest('#docs-sidebar-backdrop')) {
      document.body.removeAttribute('data-sidebar-open');
      const toggle = document.querySelector<HTMLElement>('[data-sidebar-toggle]');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

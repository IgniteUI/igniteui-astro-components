---
import './LicenseIndicator.scss';
import Badge from '../mdx/Badge/Badge.astro';

export interface Props {
  /** 'premium' shows a purple Premium badge; 'opensource' shows a green Open Source badge; false/undefined hides the badge. */
  license?: 'premium' | 'opensource' | false;
}

const { license } = Astro.props;
const label = license === 'premium' ? 'Premium' : 'Open Source';
---

{license && (
  <Badge variant={license} class="license-indicator-badge">
      <span>{label}</span>

      {license === 'premium' && <igc-icon name="premium" collection="docs" class="license-indicator-icon" aria-hidden="true"></igc-icon>}
  </Badge>
)}

---
/**
 * GlobalFooter
 *
 * Renders the IG global footer directly in the light DOM.
 *
 * Props:
 *   lang – locale (default: 'en')
 */
interface Props {
  lang: NavLang;
}

import { fetchIgNav } from '../../lib/nav-helpers.ts';
import styles from './GlobalFooter.module.scss';
import type { NavLang } from '../../platform.ts';

interface Props {
  lang: NavLang;
}

const { lang } = Astro.props as Props;

const resolvedLang = lang;

// Fetch footer HTML directly (cached per locale per build).
const igNav = await fetchIgNav(resolvedLang);
---

<div class={styles.footer} data-igd-footer>
  {/* === IgniteUI / default Infragistics footer — fetched via fetchIgNav() === */}
  {
    igNav?.prefetched && (
      <>
        <Fragment set:html={igNav.uiFooterHtml} />
        {igNav.footerHtml && <Fragment set:html={igNav.footerHtml} />}
      </>
    )
  }
</div>

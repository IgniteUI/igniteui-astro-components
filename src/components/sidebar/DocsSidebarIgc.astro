---
/**
 * Docs sidebar using <igc-tree> / <igc-tree-item> from igniteui-webcomponents.
 *
 * Drop-in replacement for DocsSidebar.astro with identical Props.
 * The tree component is registered client-side; SSR emits the initial
 * `expanded` state for groups, and the current page is highlighted via
 * `aria-current="page"` on the rendered link.
 *
 * Package: igniteui-webcomponents  (public, MIT)
 *          or @infragistics/igniteui-webcomponents  (licensed — same API,
 *          change the import path in the <script> block below).
 */
import { sidebar as sidebarData } from 'virtual:docs-template/site-meta';
import SidebarFilterInput from './SidebarFilterInputIgc.astro';
import SidebarTreeIgc from './SidebarTreeIgc.astro';
import type { SidebarEntry } from '../../lib/sidebar/types';

interface Props {
  currentSlug?: string;
  /**
   * Sidebar tree to render. Overrides the virtual module value when provided.
   * Useful when consuming the component without `siteMetaIntegration`.
   */
  items?: SidebarEntry[];
}

const { currentSlug = '', items: itemsProp } = Astro.props;
const items = (itemsProp ?? sidebarData) as SidebarEntry[];
---

<sidebar-filter-igc id="docs-sidebar" data-no-results="No topics match">
  <SidebarFilterInput />
  <div class="sidebar-scroll" data-sidebar-scroll>
    <igc-tree toggle-node-on-click>
      <SidebarTreeIgc items={items} currentSlug={currentSlug} />
    </igc-tree>
  </div>
</sidebar-filter-igc>

<script>
  // Register required Ignite UI Web Components.
  // To use the licensed package instead, change the import to:
  //   import { ... } from '@infragistics/igniteui-webcomponents';
  import {
    defineComponents,
    IgcTreeComponent,
    IgcTreeItemComponent,
    IgcInputComponent,
    IgcButtonComponent,
    IgcIconComponent,
    registerIconFromText,
  } from 'igniteui-webcomponents';

  defineComponents(IgcTreeComponent, IgcTreeItemComponent, IgcInputComponent, IgcButtonComponent, IgcIconComponent);

  registerIconFromText(
    'sidebar-filter-search',
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none"><path d="M1 3h14M4 8h8M7 13h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  );
  registerIconFromText(
    'sidebar-filter-clear',
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" fill="none"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`,
  );

  import './sidebar-filter-igc';
</script>

<style>
  /* ── Layout (own elements — no :global needed) ───────────────────────── */
  sidebar-filter-igc {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .sidebar-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    margin-inline-end: calc(-1 * var(--sl-sidebar-pad-x, 1rem));
    padding-inline-end: var(--sl-sidebar-pad-x, 1rem);
  }

  /* igc-tree is rendered here — scoped is fine */
  igc-tree {
    display: block;
    --ig-tree-background: transparent;
    --igc-tree-indentation-size: 0px;
  }

  /*
  * All rules below target elements rendered by SidebarItemIgc.astro or
  * SidebarFilterInputIgc.astro (different component scopes). They MUST use
   * :global() — otherwise Astro's scoped CSS attribute won't match.
   *
   * ::part() selectors: :global() wraps the host, e.g.
   *   :global(igc-tree-item)::part(wrapper)
   */

  /* ── Reset igc-tree-item shadow parts ───────────────────────────────── */
  :global(igc-tree-item)::part(wrapper) {
    padding: 0;
    background: transparent;
    border-radius: 0;
    min-height: unset;
    gap: 0;
    cursor: default;
  }
  :global(igc-tree-item)::part(wrapper):hover {
    background: transparent;
  }

  /* Label fills the full row width. */
  :global(igc-tree-item)::part(label) {
    flex: 1;
    min-width: 0;
    overflow: visible;
  }

  /* ── Group labels ────────────────────────────────────────────────────── */
  :global(.group-label) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--sl-text-xs, 0.75rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--sl-color-gray-3, #888);
    padding: 0.5rem 0 0.25rem;
    cursor: pointer;
    user-select: none;
  }

  :global(.group-label-text) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Caret pinned to trailing edge, rotates on expand. */
  :global(.group-caret) {
    flex-shrink: 0;
    margin-inline-start: auto;
    color: var(--sl-color-gray-3, #888);
    transform: rotate(0deg);
    transition: transform 120ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.group-caret) { transition: none; }
  }

  /* igc-tree-item reflects `expanded` as an attribute. */
  :global(igc-tree-item[expanded] [slot="label"] .group-caret) {
    transform: rotate(90deg);
  }

  /* ── Links ───────────────────────────────────────────────────────────── */
  :global(.nav-link) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    border-radius: 0.25rem;
    font-size: var(--sl-text-sm, 0.875rem);
    color: var(--sl-color-text, inherit);
    text-decoration: none;
    line-height: 1.4;
    cursor: pointer;
  }
  :global(.nav-link:hover) {
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
    color: var(--sl-color-accent, #3b82f6);
    text-decoration: none;
  }
  :global(.nav-link[aria-current='page']) {
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
    color: var(--sl-color-accent, #3b82f6);
    font-weight: 600;
  }

  :global(.link-label) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── Nested item indentation ─────────────────────────────────────────── */
  :global(igc-tree-item.sidebar-item--nested)::part(wrapper) {
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--sl-color-hairline, #e2e4e9);
    margin-inline-start: 0.25rem;
  }

  /* ── Badges ──────────────────────────────────────────────────────────── */
  :global(.sl-badge) {
    display: inline-flex;
    align-items: center;
    border-radius: 0.25rem;
    padding: 0.1rem 0.35rem;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid currentColor;
    margin-inline-start: auto;
    flex-shrink: 0;
  }
  :global(.sl-badge.default) { color: var(--sl-color-gray-3); }
  :global(.sl-badge.note)    { color: hsl(234, 90%, 60%); }
  :global(.sl-badge.tip)     { color: hsl(134, 70%, 38%); }
  :global(.sl-badge.success) { color: hsl(134, 70%, 38%); }
  :global(.sl-badge.caution) { color: hsl(40, 90%, 45%); }
  :global(.sl-badge.danger)  { color: hsl(0, 85%, 52%); }

  /* ── Filter: CSS-driven via [data-filtering] + [data-filter-match] ──── */
  /* igc-tree-item is from SidebarItemIgc → :global() required */
  sidebar-filter-igc[data-filtering] :global(igc-tree-item[data-path]:not([data-filter-match])) {
    display: none;
  }

  /* [data-sidebar-filter-status] is from SidebarFilterInput → :global() required */
  sidebar-filter-igc :global([data-sidebar-filter-status]):not(:empty) {
    display: block;
    padding: 0.5rem;
    font-size: var(--sl-text-sm, 0.875rem);
    color: var(--sl-color-gray-3, #888);
  }
</style>

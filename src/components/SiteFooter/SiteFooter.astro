---
/**
 * SiteFooter - the Infragistics global footer, compiled into the package.
 */
import { Image } from 'astro:assets';
import '../chrome/chrome.css';
import igLogoDark from './assets/ig-logo-dark.svg';
import imgSoc2Seal from './assets/soc2-seal.png';
import imgGdprBadge from './assets/gdpr-badge.png';
import imgSoc2Shield from './assets/soc2-shield.png';
import FooterLinks from './FooterLinks.astro';
import {
  FOOTER_COLUMNS,
  FOOTER_LEGAL,
  FOOTER_MORE_PRODUCTS,
  FOOTER_SOCIAL,
  type FooterGroup,
  type FooterLegalLink,
  type FooterLink,
  type FooterSocial,
} from './footer-config';

export interface NewsletterOptions {
  /**
   * Config for your own `[data-lead-form]` client, serialised onto the wrapper.
   */
  config: unknown;
  ready?: boolean;
}

export interface Props {
  /** Render the newsletter card. Omitted means no card — see the note above. */
  newsletter?: NewsletterOptions;
  cookieSettings?: boolean;
  /** Link columns. Defaults to the shipped set. */
  columns?: FooterGroup[][];
  /** The "More Infragistics Products" strip. Defaults to the shipped set. */
  moreProducts?: FooterLink[];
  /** Legal row. Defaults to the shipped set. */
  legal?: FooterLegalLink[];
  /** Social icons. Defaults to the shipped set. */
  social?: readonly FooterSocial[];
  /** Copyright year. Defaults to the build year. */
  year?: number;
}

const {
  newsletter,
  cookieSettings = false,
  columns = FOOTER_COLUMNS,
  moreProducts = FOOTER_MORE_PRODUCTS,
  legal = FOOTER_LEGAL,
  social = FOOTER_SOCIAL,
  year = new Date().getFullYear(),
} = Astro.props;

const newsletterConfig = newsletter?.config;
const newsletterReady = newsletter?.ready !== false;

/** `Learn & Support` -> `learn-support`, for the id the toggle is named by. */
const groupId = (title: string) =>
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<footer class="ftr">
  <span class="ftr__glow ftr__glow--violet" aria-hidden="true"></span>
  <span class="ftr__glow ftr__glow--teal" aria-hidden="true"></span>

  <div class="ftr__inner">
    {/* ── masthead ───────────────────────────────────────────── */}
    <div class="ftr__top">
      <a href="/" class="ftr__logo" aria-label="Infragistics home">
        <img src={igLogoDark.src} alt="Infragistics" width="172" height="24" />
      </a>

      <ul class="ftr__social" role="list" aria-label="Follow Infragistics">
        {
          social.map((s) => (
            <li>
              <a
                href={s.href}
                class="ftr__social-link"
                aria-label={s.href.startsWith('http') ? `${s.title} (opens in new tab)` : s.title}
                {...(s.href.startsWith('http') ? { rel: 'noopener', target: '_blank' } : {})}
              >
                <svg
                  width={s.size}
                  height={s.size}
                  viewBox="0 0 24 24"
                  fill={s.stroke ? 'none' : 'currentColor'}
                  {...(s.stroke
                    ? {
                        stroke: 'currentColor',
                        'stroke-width': '2',
                        'stroke-linecap': 'round',
                        'stroke-linejoin': 'round',
                      }
                    : {})}
                  aria-hidden="true"
                >
                  {s.paths.map((d) => (
                    <path d={d} />
                  ))}
                  {s.dot && <circle cx={s.dot.cx} cy={s.dot.cy} r={s.dot.r} />}
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* ── link columns ───────────────────────────────────────── */}
    <nav class="ftr__nav" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="ftr__col">
            {col.map((group) => (
              <div class="ftr__group" data-ftr-group data-open="true">
                <h2 class="ftr__group-title">
                  <span class="ftr__group-text" id={`ftr-g-${groupId(group.title)}`}>
                    {group.title}
                  </span>
                  <button
                    type="button"
                    class="ftr__group-btn"
                    aria-expanded="true"
                    aria-labelledby={`ftr-g-${groupId(group.title)}`}
                    data-ftr-toggle
                  >
                    <svg
                      class="ftr__chev"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                </h2>
                <FooterLinks links={group.links} />
              </div>
            ))}
          </div>
        ))
      }
    </nav>

    {/* ── the other Infragistics products ────────────────────── */}
    <div class="ftr__more">
      <h2 class="ftr__eyebrow">More Infragistics Products</h2>
      <FooterLinks links={moreProducts} />
    </div>

    {/* ── newsletter ─────────────────────────────────────────── */}
    {
      newsletter && (
        <section class="ftr__news" aria-labelledby="ftr-news-title">
          <div class="ftr__news-intro">
            <h2 class="ftr__news-title" id="ftr-news-title">
              Newsletter
            </h2>
            <p class="ftr__news-blurb">
              Product releases, webinars and developer resources from Infragistics.
            </p>
          </div>

          <div
            class="ftr__news-form"
            data-lead-form
            data-lead-config={JSON.stringify(newsletterConfig)}
          >
            {!newsletterReady && (
              <p class="ftr__notice" role="status">
                Newsletter signup is not connected in this environment.
              </p>
            )}

            <form class="ftr__form" novalidate>
              <div class="ftr__field">
                <label class="ig-sr-only" for="ftr-email">
                  Your email address
                </label>
                <input
                  id="ftr-email"
                  name="Email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="Your email address"
                  class="ftr__input"
                  disabled={!newsletterReady}
                />
                <button type="submit" class="ftr__submit" disabled={!newsletterReady}>
                  Subscribe
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </button>
              </div>

              <label class="ftr__consent">
                <span class="ftr__check">
                  <input
                    type="checkbox"
                    name="acceptGDPRFormSubmission"
                    required
                    disabled={!newsletterReady}
                  />
                  <svg
                    class="ftr__check-mark"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <span>
                  {/* Explicit spaces: a newline between text and an element is
                   * collapsed away, and the line rendered as
                   * "infragistics'Terms of Use andPrivacy Policy". */}
                  I understand and agree to the terms of infragistics'{' '}
                  <a href="/legal/terms-of-use">Terms of Use</a> and{' '}
                  <a href="/legal/privacy">Privacy Policy</a>
                </span>
              </label>

              {/* The honeypot. Off-screen and out of the tab order. */}
              <div class="ftr__trap" aria-hidden="true">
                <label for="ftr-hp">Leave this field empty</label>
                <input id="ftr-hp" name="lf_hp" type="text" tabindex="-1" autocomplete="off" />
              </div>

              <p class="ftr__error" data-form-error hidden />

              <p class="ftr__recaptcha">
                This site is protected by reCAPTCHA and the Google{' '}
                <a href="https://policies.google.com/privacy" rel="noopener" target="_blank">
                  Privacy Policy
                </a>{' '}
                and{' '}
                <a href="https://policies.google.com/terms" rel="noopener" target="_blank">
                  Terms of Use
                </a>{' '}
                apply
              </p>
            </form>

            <div class="ftr__thankyou" data-thankyou role="status" hidden>
              <p class="ftr__thankyou-title">Thank you for subscribing.</p>
              <p>
                Look for an email from{' '}
                <a href="mailto:team@Infragistics.com">team@Infragistics.com</a> for the latest news
                for Developers, UX, and Business Teams.
              </p>
            </div>
          </div>
        </section>
      )
    }
  </div>

  {/* ── legal bar ────────────────────────────────────────────── */}
  <div class="ftr__bottom">
    <div class="ftr__bottom-inner">
      <nav aria-label="Legal">
        <ul class="ftr__legal" role="list">
          {
            legal.map((l) => (
              <li>
                <a href={l.href} class="ftr__legal-link">
                  {l.label}
                </a>
              </li>
            ))
          }
          {
            cookieSettings && (
              <li>
                <button type="button" class="ftr__legal-link ftr__legal-btn" data-consent-open>
                  Cookie Settings
                </button>
              </li>
            )
          }
        </ul>
      </nav>

      <div class="ftr__colophon">
        <p class="ftr__copyright">© Copyright {year} INFRAGISTICS. All Rights Reserved</p>
        <div class="ftr__badges">
          <Image src={imgSoc2Seal} alt="I.S. Partners SOC2 SEAL" height={40} loading="lazy" />
          <Image src={imgGdprBadge} alt="GDPR compliant" height={40} loading="lazy" />
          <Image src={imgSoc2Shield} alt="IS Partners LLC" height={40} loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    overflow: hidden;
    background: linear-gradient(155deg, #16213d 0%, #101a30 42%, #0a0d16 100%);
    color: #aab4c4;
  }

  /* ── decorative washes ── */
  .ftr__glow {
    position: absolute;
    pointer-events: none;
  }
  .ftr__glow--violet {
    top: -380px;
    right: -220px;
    width: 760px;
    height: 760px;
    background: radial-gradient(circle, rgb(152 16 250 / 0.42), transparent 62%);
  }
  .ftr__glow--teal {
    bottom: -260px;
    left: -200px;
    width: 640px;
    height: 640px;
    background: radial-gradient(circle, rgb(45 212 191 / 0.12), transparent 64%);
  }

  .ftr__inner {
    position: relative;
    max-width: var(--ig-container);
    margin-inline: auto;
    padding: 40px var(--ig-section-x) 0;
  }

  /* ── masthead ── */
  .ftr__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding-bottom: 32px;
    margin-bottom: 44px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .ftr__logo {
    display: inline-flex;
  }
  .ftr__logo img {
    height: 24px;
    width: auto;
    display: block;
  }

  .ftr__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ftr__social li {
    display: flex;
  }
  .ftr__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--ig-radius-pill, 9999px);
    border: 1px solid rgb(255 255 255 / 0.14);
    color: #aab4c4;
    transition:
      color 160ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 160ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ftr__social-link:hover {
    color: #fff;
    border-color: rgb(125 211 252 / 0.55);
    background: rgb(56 189 248 / 0.14);
  }

  /* ── link columns ──
   * `auto-fit` rather than a fixed five: the columns are unequal in height and
   * this lets the row reflow to four, three or two before the phone accordion
   * takes over, with no breakpoint per step. */
  .ftr__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 40px 28px;
    align-items: start;
    padding-bottom: 56px;
  }
  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: 11px;
    min-width: 0;
  }
  .ftr__group {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .ftr__group + .ftr__group {
    margin-top: 21px;
  }
  .ftr__group-title,
  .ftr__group-text,
  .ftr__eyebrow {
    font-size: 12px;
    font-weight: 600;
    line-height: normal;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #8a94a6;
  }
  .ftr__group-title {
    margin: 0 0 5px;
  }
  .ftr__group-btn {
    display: none;
    align-items: center;
    justify-content: flex-end;
    padding: 0;
    background: none;
    border: none;
    color: #8a94a6;
    cursor: pointer;
  }
  .ftr__chev {
    flex: 0 0 auto;
    transition: transform 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ftr__group[data-open='true'] .ftr__chev {
    transform: rotate(180deg);
  }

  /* ── more products ── */
  .ftr__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    padding: 18px 0;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .ftr__eyebrow {
    margin: 0;
  }
  /* The one place a link list runs across rather than down. */
  .ftr__more :global(.ftr__list) {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  /* newsletter - two cells in one card: blurb and form. */
  .ftr__news {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    align-items: center;
    gap: 20px 48px;
    margin: 0 0 40px;
    padding: 28px clamp(20px, 3vw, 36px);
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 18px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.02));
  }
  .ftr__news-intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .ftr__news-title {
    margin: 0;
    font-family: var(--ig-font-display);
    font-size: 22px;
    line-height: 1.2;
    font-weight: var(--ig-fw-xbold);
    letter-spacing: -0.4px;
    color: #fff;
  }
  .ftr__news-blurb {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: #aab4c4;
    text-wrap: pretty;
  }
  .ftr__news-form {
    min-width: 0;
  }

  .ftr__form[hidden] {
    display: none;
  }
  .ftr__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .ftr__field {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 5px 5px 5px 18px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 26px;
    background: rgb(10 13 22 / 0.6);
    transition: border-color 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ftr__field:focus-within {
    border-color: #38bdf8;
  }

  .ftr__field :global(.field-validation-error-msg) {
    order: 2;
    flex: 1 0 100%;
    margin: 0 -5px -5px -18px;
    border-radius: 0 0 25px 25px;
  }
  .ftr__input {
    order: 0;
    flex: 1 1 0;
    min-width: 0;
    height: 40px;
    padding: 0;
    border: none;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 15px;
  }
  .ftr__input::placeholder {
    color: #7c8393;
  }
  /* The ring is on the pill, so the field inside it must not draw a second
   * one - see `:focus-within` above. */
  .ftr__input:focus,
  .ftr__input:focus-visible {
    outline: none;
  }
  /*
   * Autofill.
   */
  .ftr__input:autofill {
    box-shadow: 0 0 0 100vmax #0e121a inset;
    -webkit-text-fill-color: #fff;
    caret-color: #fff;
  }
  .ftr__input:-webkit-autofill,
  .ftr__input:-webkit-autofill:hover,
  .ftr__input:-webkit-autofill:focus,
  .ftr__input:-webkit-autofill:active {
    box-shadow: 0 0 0 100vmax #0e121a inset;
    -webkit-text-fill-color: #fff;
    caret-color: #fff;
  }

  .ftr__submit {
    order: 1;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 20px;
    border: 0;
    border-radius: var(--ig-radius-pill, 9999px);
    background: #155dfc;
    color: #fff;
    font: inherit;
    font-size: 15px;
    font-weight: var(--ig-fw-semibold);
    white-space: nowrap;
    cursor: pointer;
    transition: background 180ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ftr__submit:hover:not(:disabled) {
    background: #0f4fd6;
  }
  .ftr__submit:active:not(:disabled) {
    background: #0070bf;
  }
  /* The client ships the button disabled and enables it off the consent box,
   * and disables every field again while a submit is in flight. */
  .ftr__input:disabled,
  .ftr__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .ftr__consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 1.55;
    color: #aab4c4;
    cursor: pointer;
    text-wrap: pretty;
  }
  .ftr__check {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    width: 16px;
    height: 16px;
    margin-top: 1px;
  }
  .ftr__check input {
    appearance: none;
    -webkit-appearance: none;
    margin: 0;
    width: 16px;
    height: 16px;
    border: 1.5px solid rgb(255 255 255 / 0.3);
    border-radius: 5px;
    background: transparent;
    cursor: pointer;
    transition:
      background 140ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 140ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ftr__check input:checked {
    border-color: #155dfc;
    background: #155dfc;
  }
  .ftr__check input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .ftr__check-mark {
    position: absolute;
    inset: 0;
    padding: 2px;
    color: #fff;
    opacity: 0;
    pointer-events: none;
    transition: opacity 140ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ftr__check input:checked + .ftr__check-mark {
    opacity: 1;
  }

  .ftr__consent a {
    color: #e6ebf2;
    text-decoration: none;
    transition: color 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ftr__recaptcha a {
    color: #aab4c4;
    text-decoration: none;
  }
  .ftr__consent a:hover,
  .ftr__recaptcha a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ftr__error,
  .ftr__recaptcha {
    margin: 0;
    padding-left: 26px;
  }
  .ftr__recaptcha {
    font-size: 12px;
    line-height: 1.55;
    color: #8a94a6;
    text-wrap: pretty;
  }
  .ftr__error {
    font-size: 13px;
    line-height: 1.4;
    color: #f87171;
  }
  .ftr__notice {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.5;
    color: #8a94a6;
  }

  .ftr__thankyou {
    color: #cfd4dd;
    font-size: 14px;
    line-height: 1.55;
  }
  /* The canvas marks a successful signup in its success teal; the body stays
   * readable grey so the colour means "this worked" and not "all of this is
   * important". */
  .ftr__thankyou-title {
    margin: 0 0 4px;
    color: #2dd4bf;
    font-weight: var(--ig-fw-semibold);
  }
  .ftr__thankyou p:last-child {
    margin: 0;
  }
  .ftr__thankyou a {
    color: #e6ebf2;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ftr__thankyou a:hover {
    color: #fff;
  }

  .ftr__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── legal bar ── */
  .ftr__bottom {
    position: relative;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .ftr__bottom-inner {
    max-width: var(--ig-container);
    margin-inline: auto;
    padding: 28px var(--ig-section-x) 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .ftr__legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 10px;
    font-size: 14px;
  }
  /* Hairline separators */
  .ftr__legal li {
    padding: 0 14px;
    border-left: 1px solid rgb(255 255 255 / 0.18);
    line-height: 14px;
    white-space: nowrap;
  }
  .ftr__legal li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .ftr__legal-link {
    color: #aab4c4;
    text-decoration: none;
    transition: color 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ftr__legal-link:hover {
    color: #fff;
  }
  /* The consent control is a button but must be indistinguishable from the
     <a> siblings beside it. */
  .ftr__legal-btn {
    appearance: none;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    line-height: inherit;
    cursor: pointer;
  }

  .ftr__colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .ftr__copyright {
    margin: 0;
    font-size: 13.5px;
    color: #8a94a6;
  }
  .ftr__badges {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  /* `contain` on all three: none of the source marks are exactly square, and
   * letterboxing inside the 40px box is what keeps a seal round, not oval. */
  .ftr__badges :global(img) {
    height: 40px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .ftr a:focus-visible,
  .ftr button:focus-visible {
    outline: 3px solid #7dd3fc;
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* ── phones ──
   * Each group collapses to a single 48px row. The columns become one, the
   * gaps go to zero and the hairlines between groups carry the rhythm
   * instead. Keep this query in step with the one in the script below. */
  @media (max-width: 640px) {
    .ftr__nav {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-bottom: 32px;
    }
    .ftr__col {
      gap: 0;
    }
    .ftr__group {
      gap: 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }
    .ftr__group + .ftr__group {
      margin-top: 0;
    }
    .ftr__group-title {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 48px;
      margin: 0;
    }
    .ftr--js .ftr__group-btn {
      display: flex;
      position: absolute;
      inset: 0;
    }
    .ftr__group > :global(.ftr__list) {
      display: none;
      padding-bottom: 18px;
    }
    .ftr__group[data-open='true'] > :global(.ftr__list) {
      display: flex;
    }
  }

  /*
   * Phones: the products strip stays on ONE line.
   */
  @media (max-width: 560px) {
    .ftr__more {
      flex-wrap: nowrap;
      gap: 12px;
    }
    .ftr__more .ftr__eyebrow {
      font-size: 10px;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }
    .ftr__more :global(.ftr__list) {
      flex-wrap: nowrap;
      gap: 0 18px;
    }
    .ftr__more .ftr__eyebrow,
    .ftr__more :global(.ftr__list) {
      flex: 0 0 auto;
    }
  }

  /*
   * Below this even the tightened strip does not fit a line, so it is allowed
   * to wrap again rather than overflow.
   */
  @media (max-width: 354px) {
    .ftr__more,
    .ftr__more :global(.ftr__list) {
      flex-wrap: wrap;
    }
  }

  /* Narrow phones. */
  @media (max-width: 380px) {
    .ftr__field {
      padding-left: 14px;
    }
    .ftr__submit {
      gap: 6px;
      padding: 0 14px;
    }
    .ftr__field :global(.field-validation-error-msg) {
      margin-left: -14px;
    }
  }

  @media (max-width: 389px) {
    .ftr__legal {
      gap: 10px 20px;
    }
    .ftr__legal li {
      padding: 0;
      border-left: 0;
    }
  }
</style>

<script>
  const phone = window.matchMedia('(max-width: 640px)');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-ftr-group]'));
  for (const footer of document.querySelectorAll('footer.ftr')) footer.classList.add('ftr--js');

  const setOpen = (group: HTMLElement, open: boolean) => {
    group.dataset.open = String(open);
    group
      .querySelector<HTMLButtonElement>('[data-ftr-toggle]')
      ?.setAttribute('aria-expanded', String(open));
  };

  const sync = () => groups.forEach((g) => setOpen(g, !phone.matches));

  for (const group of groups) {
    group.querySelector<HTMLButtonElement>('[data-ftr-toggle]')?.addEventListener('click', () => {
      setOpen(group, group.dataset.open !== 'true');
    });
  }

  phone.addEventListener('change', sync);
  sync();
</script>

---
/**
 * SiteFooter — the Infragistics global footer, compiled into the package.
 *
 * From the "Light Bento Compact v2 (Enterprise)" canvas: near-black band, a
 * centred social row, four link columns, an optional newsletter panel, then
 * legal links, compliance badges and a copyright bar.
 *
 * ── What is a prop, and why ────────────────────────────────────────────────
 *
 * On the marketing site this component reaches into that repo for three things:
 * the lead-form config builder, two environment flags, and the form client. A
 * package cannot: the newsletter posts to the IS Cloud API, which answers only
 * to origins on an allow-list, so a consumer on another hostname must not be
 * handed a form that silently fails.
 *
 * So the newsletter is OPT-IN and caller-wired. Omit `newsletter` and the panel
 * is not rendered at all — the rest of the footer is unaffected. Pass it and
 * you own two things: the config JSON, and mounting a client against
 * `[data-lead-form]`.
 *
 * The field NAMES are that client's contract, not cosmetic: `Email`,
 * `acceptGDPRFormSubmission`, the `lf_hp` honeypot, `[data-form-error]` and
 * `[data-thankyou]`. Rename one and the form silently stops working.
 *
 * `columns`, `legal` and `social` default to the shipped configuration and are
 * overridable, so a site that needs a different set of links does not have to
 * fork the component to get one.
 */
import { Image } from 'astro:assets';
import imgSoc2Seal from './assets/soc2-seal.png';
import imgGdprBadge from './assets/gdpr-badge.png';
import imgSoc2Shield from './assets/soc2-shield.png';
import {
  FOOTER_COLUMNS,
  FOOTER_LEGAL,
  FOOTER_SOCIAL,
  type FooterGroup,
  type FooterLink,
} from './footer-config';

/** One social icon, as `FOOTER_SOCIAL` shapes them. */
export type FooterSocial = (typeof FOOTER_SOCIAL)[number];

export interface NewsletterOptions {
  /**
   * Config for your own `[data-lead-form]` client, serialised onto the wrapper.
   *
   * On the marketing site this is `buildLeadFormConfig({ leadSourceNumber:
   * '9100010', eventDetail: 'newsletter signup', prohibitDisposableMail: true })`
   * — lead source 9100010 is the newsletter row, and disposable addresses are
   * refused while free ones are not, because a newsletter is the one signup
   * where a personal address is a real reader.
   */
  config: unknown;
  /**
   * False renders the fields disabled with a "not connected" notice, which is
   * what the marketing site does when the API is unconfigured. A form that
   * looks live and loses the signup is worse than one that admits it is not
   * connected. Defaults to true.
   */
  ready?: boolean;
}

export interface Props {
  /** Render the newsletter panel. Omitted means no panel — see the note above. */
  newsletter?: NewsletterOptions;
  /** Link columns. Defaults to the shipped set. */
  columns?: FooterGroup[][];
  /** Legal row. Defaults to the shipped set. */
  legal?: FooterLink[];
  /** Social icons. Defaults to the shipped set. */
  social?: FooterSocial[];
  /** Copyright year. Defaults to the build year. */
  year?: number;
}

const {
  newsletter,
  columns = FOOTER_COLUMNS,
  legal = FOOTER_LEGAL,
  social = FOOTER_SOCIAL,
  year = new Date().getFullYear(),
} = Astro.props;

const newsletterConfig = newsletter?.config;
const newsletterReady = newsletter?.ready !== false;

/** Inline so the footer carries no icon-font or sprite dependency. */
const SOCIAL_PATHS: Record<string, string> = {
  RSS: 'M4 10.5a9.5 9.5 0 0 1 9.5 9.5h3A12.5 12.5 0 0 0 4 7.5v3Z M4 3.5a16.5 16.5 0 0 1 16.5 16.5h3A19.5 19.5 0 0 0 4 .5v3Z',
  X: 'M18.9 2h3.3l-7.2 8.2L23.5 22h-6.6l-5.2-6.8L5.8 22H2.5l7.7-8.8L2 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.4 3.9H5.5L17.7 20Z',
  Facebook:
    'M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.2v1.8H8v3h2.6V22H14v-8.5h2.6l.4-3H14Z',
  LinkedIn:
    'M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.6h.05c.53-1 1.83-2.06 3.77-2.06C20.6 8.54 22 10.2 22 13.4V21h-4v-6.7c0-1.6-.03-3.65-2.22-3.65-2.22 0-2.56 1.73-2.56 3.53V21H9V9Z',
  YouTube:
    'M23 7.5c-.26-1-1-1.75-2-2C19.2 5 12 5 12 5s-7.2 0-9 .5c-1 .25-1.74 1-2 2C.5 9.3.5 12 .5 12s0 2.7.5 4.5c.26 1 1 1.75 2 2C4.8 19 12 19 12 19s7.2 0 9-.5c1-.25 1.74-1 2-2 .5-1.8.5-4.5.5-4.5s0-2.7-.5-4.5ZM9.8 15.3V8.7l5.7 3.3-5.7 3.3Z',
  Discord:
    'M19.5 5.6A16.5 16.5 0 0 0 15.4 4.3l-.2.4a12.5 12.5 0 0 1 3.6 1.8 12 12 0 0 0-10.5 0 12.5 12.5 0 0 1 3.6-1.8l-.2-.4A16.5 16.5 0 0 0 4.5 5.6C2 9.3 1.3 13 1.6 16.6a16.6 16.6 0 0 0 5 2.5l.4-.6c-.7-.2-1.3-.5-1.9-.9l.5-.4a11.9 11.9 0 0 0 10.8 0l.5.4c-.6.4-1.2.7-1.9.9l.4.6a16.6 16.6 0 0 0 5-2.5c.4-4.2-.6-7.8-2.4-11Zm-11 8.9c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.9 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z',
};
---

<footer class="ftr">
  <div class="ftr__inner">
    {/* ── social ─────────────────────────────────────────────── */}
    <div class="ftr__social">
      {
        social.map((s) => (
          <a
            href={s.href}
            aria-label={s.label}
            class="ftr__social-link"
            {...(s.href.startsWith('http') ? { rel: 'noopener', target: '_blank' } : {})}
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              {s.label === 'RSS' && <circle cx="5" cy="19" r="2.2" />}
              {SOCIAL_PATHS[s.label].split(' M').map((d, i) => (
                <path d={i === 0 ? d : `M${d}`} />
              ))}
            </svg>
          </a>
        ))
      }
    </div>

    {/* ── columns + newsletter ───────────────────────────────── */}
    <div class="ftr__body">
      <div class="ftr__columns">
        {
          columns.map((col) => (
            <div class="ftr__col">
              {/* A <details> so each group collapses on phones. Rendered open, so
               * every link shows without the script; the script below closes
               * them on phones and keeps them open on anything wider. */}
              {col.map((group) => (
                <details class="ftr__group" open data-ftr-group>
                  <summary class="ftr__group-title">
                    {group.title}
                    <svg
                      class="ftr__chev"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </summary>
                  <div class="ftr__group-links">
                    {group.links.map((l) => (
                      <a
                        href={l.href}
                        class="ftr__link"
                        {...(l.external ? { rel: 'noopener', target: '_blank' } : {})}
                      >
                        {l.label}
                      </a>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          ))
        }
      </div>

      {
        newsletter && (
          <div class="ftr__news">
            <h2 class="ftr__news-title">
              The best blogs, whitepapers, and other <span class="ig-gradient-text">resources</span>
            </h2>

            <div
              class="ftr__news-form"
              data-lead-form
              data-lead-config={JSON.stringify(newsletterConfig)}
            >
              {!newsletterReady && (
                <p class="ftr__notice" role="status">
                  Newsletter signup is not connected in this environment.
                </p>
              )}

              <form class="ftr__form" novalidate>
                <label class="ig-sr-only" for="ftr-email">
                  Your email address
                </label>
                <input
                  id="ftr-email"
                  name="Email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="Your email address"
                  class="ftr__input"
                  disabled={!newsletterReady}
                />

                <label class="ftr__consent">
                  <input
                    type="checkbox"
                    name="acceptGDPRFormSubmission"
                    required
                    disabled={!newsletterReady}
                  />
                  <span>
                    {/* Explicit spaces: a newline between text and an element is
                     * collapsed away, and the line rendered as
                     * "infragistics'Terms of Use andPrivacy Policy". */}
                    I understand and agree to the terms of infragistics'{' '}
                    <a href="/legal/terms-of-use">Terms of Use</a> and{' '}
                    <a href="/legal/privacy">Privacy Policy</a>
                  </span>
                </label>

                {/* The honeypot. Off-screen and out of the tab order, so only a bot
                 * fills it - and named `lf_hp` rather than anything an address
                 * autofill would recognise. See the note in LeadForm.astro. */}
                <div class="ftr__trap" aria-hidden="true">
                  <label for="ftr-hp">Leave this field empty</label>
                  <input id="ftr-hp" name="lf_hp" type="text" tabindex="-1" autocomplete="off" />
                </div>

                <p class="ftr__recaptcha">
                  This site is protected by reCAPTCHA and the Google{' '}
                  <a href="https://policies.google.com/privacy" rel="noopener" target="_blank">
                    Privacy Policy
                  </a>{' '}
                  and{' '}
                  <a href="https://policies.google.com/terms" rel="noopener" target="_blank">
                    Terms of Use
                  </a>{' '}
                  apply
                </p>

                <p class="ftr__error" data-form-error hidden />

                <button type="submit" class="ftr__submit" disabled={!newsletterReady}>
                  Sign Me Up!
                </button>
              </form>

              <div class="ftr__thankyou" data-thankyou hidden>
                <p class="ftr__thankyou-title">Thank you for subscribing.</p>
                <p>
                  Look for an email from{' '}
                  <a href="mailto:team@Infragistics.com">team@Infragistics.com</a> for the latest
                  news for Developers, UX, and Business Teams.
                </p>
              </div>
            </div>
          </div>
        )
      }
    </div>

    {/* ── legal ──────────────────────────────────────────────── */}
    <div class="ftr__legal">
      {
        legal.map((l) => (
          <a href={l.href} class="ftr__legal-link">
            {l.label}
            {l.note && <span class="ftr__note"> {l.note}</span>}
          </a>
        ))
      }
      {
        /* Withdrawing consent has to be as easy as giving it (GDPR Art. 7(3)),
          which means a control on every page rather than a policy page that
          only describes the choice. A <button>, because it opens a dialog and
          does not navigate; consentBanner.ts binds [data-consent-open] and
          re-opens the panel showing the STORED decision. */
      }
      <button type="button" class="ftr__legal-link ftr__legal-btn" data-consent-open>
        Cookie Settings
      </button>
    </div>

    {/* ── compliance ─────────────────────────────────────────── */}
    <div class="ftr__badges">
      <Image
        src={imgSoc2Seal}
        alt="SOC 2 certified — IS Partners LLC, Certified Public Accountants"
        width="38"
        loading="lazy"
      />
      <Image src={imgGdprBadge} alt="GDPR compliant" width="38" height="38" loading="lazy" />
      <Image
        src={imgSoc2Shield}
        alt="SOC 2 audited"
        width="36"
        class="ftr__badge--shield"
        loading="lazy"
      />
    </div>
  </div>

  <div class="ftr__copyright">© Copyright {year} INFRAGISTICS. All Rights Reserved</div>
</footer>

<style>
  /*
   * The marketing site sets `box-sizing: border-box` globally in its design
   * system; a package cannot assume a host page does. Without it
   * `.ftr__input { width: 100%; padding: 13px 16px; border: 1px }` measures
   * 34px wider than its column and pushes a horizontal scrollbar onto the whole
   * page — which is exactly what it did the first time this was rendered
   * outside that repo.
   *
   * Scoped to the footer, so a host page's own box model is untouched.
   */
  .ftr,
  .ftr *,
  .ftr *::before,
  .ftr *::after {
    box-sizing: border-box;
  }
  .ftr {
    background: #0a0d16;
    color: #e6e8ee;
    padding: 64px var(--ig-section-x) 0;
  }
  .ftr__inner {
    max-width: var(--ig-container);
    margin-inline: auto;
  }

  .ftr__social {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 30px;
    margin-bottom: 52px;
  }
  .ftr__social-link {
    color: var(--ig-gray-500);
    display: inline-flex;
  }
  .ftr__social-link:hover {
    color: #fff;
  }

  .ftr__body {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    justify-content: space-between;
    padding-bottom: 48px;
  }
  .ftr__columns {
    flex: 1;
    min-width: min(560px, 100%);
    display: grid;
    grid-template-columns: repeat(4, minmax(140px, 1fr));
    gap: 36px 40px;
  }
  .ftr__col {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .ftr__group-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    font-size: 15px;
    font-weight: var(--ig-fw-bold);
    color: #fff;
    margin-bottom: 14px;
  }
  .ftr__group-title::-webkit-details-marker {
    display: none;
  }
  /* Only the phone accordion is interactive; wider, the title is a heading. */
  .ftr__chev {
    display: none;
    flex: 0 0 auto;
    color: var(--ig-gray-500);
    transition: transform var(--ig-dur) var(--ig-ease);
  }
  .ftr__group-links {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .ftr__link {
    font-size: 15px;
    color: #a9afbd;
    text-decoration: none;
  }
  .ftr__link:hover {
    color: #fff;
  }

  /* ── newsletter ── */
  .ftr__news {
    flex: 0 1 360px;
    min-width: min(320px, 100%);
  }
  .ftr__news-title {
    font-family: var(--ig-font-display);
    font-size: 26px;
    line-height: 1.2;
    font-weight: var(--ig-fw-xbold);
    letter-spacing: -0.5px;
    color: #fff;
    margin: 0 0 18px;
  }
  /*
   * The honeypot, hidden the sr-only way so it stays a real field for a bot to
   * find. `overflow: hidden` + `clip-path` rather than `display: none`, which
   * bots skip as a matter of course.
   */
  .ftr__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Errors and the read-only notice, legible on the near-black band. */
  .ftr__error,
  .ftr__notice {
    margin: 0;
    color: #ffb4a9;
    font-size: 13px;
    line-height: 1.5;
  }
  .ftr__notice {
    color: #9aa1b0;
    margin-bottom: 12px;
  }
  .ftr__thankyou {
    color: #cfd4dd;
    font-size: 14px;
    line-height: 1.55;
  }
  .ftr__thankyou-title {
    margin: 0 0 4px;
    color: #fff;
    font-weight: var(--ig-fw-semibold);
  }
  .ftr__thankyou p:last-child {
    margin: 0;
  }
  /* The client disables every field while a submit is in flight. */
  .ftr__input:disabled,
  .ftr__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  /*
   * `display: flex` on a CLASS beats the UA stylesheet's `[hidden] { display:
   * none }`, so `form.hidden = true` - which is how leadForm.ts swaps in the
   * thank-you - left the form on screen with the confirmation stacked under it.
   * LeadForm's own `.leadform__form` sets no display, which is why the same
   * client behaves correctly there and this needed saying out loud.
   */
  .ftr__form[hidden] {
    display: none;
  }
  .ftr__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ftr__input {
    width: 100%;
    padding: 13px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font: inherit;
    font-size: 15px;
  }
  .ftr__input::placeholder {
    color: #7c8393;
  }
  .ftr__input:focus {
    border-color: var(--ig-blue);
    background: rgba(255, 255, 255, 0.08);
  }

  .ftr__consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 12.5px;
    line-height: 1.5;
    color: #9aa1b0;
  }
  .ftr__consent input {
    flex: 0 0 auto;
    margin-top: 2px;
    accent-color: var(--ig-blue);
  }
  .ftr__consent a,
  .ftr__recaptcha a {
    color: #a9afbd;
    text-decoration: underline;
  }
  .ftr__consent a:hover,
  .ftr__recaptcha a:hover {
    color: #fff;
  }
  .ftr__recaptcha {
    font-size: 11.5px;
    line-height: 1.5;
    color: #6f7683;
    margin: 0;
  }

  .ftr__submit {
    align-self: flex-start;
    padding: 12px 26px;
    border: 0;
    border-radius: var(--ig-radius-pill);
    background: var(--ig-blue);
    color: #fff;
    font-weight: var(--ig-fw-semibold);
    font-size: 15px;
    cursor: pointer;
    transition: background var(--ig-dur) var(--ig-ease);
  }
  .ftr__submit:hover {
    background: var(--ig-blue-600);
  }

  /* ── legal ──
   * Centred, and deliberately WITHOUT a top border: the only rule in this part
   * of the footer is the one above the copyright bar. The links are bright and
   * semibold; only the "(updated)" note is dimmed. */
  .ftr__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 30px;
    padding-top: 40px;
    font-size: 15px;
  }
  .ftr__legal-link {
    color: #e6e8ee;
    font-weight: var(--ig-fw-semibold);
    text-decoration: none;
  }
  .ftr__legal-link:hover {
    color: var(--ig-blue);
  }
  /* The consent control is a button but must be indistinguishable from the
     <a> siblings either side of it. */
  .ftr__legal-btn {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 15px;
    font-weight: var(--ig-fw-semibold);
    line-height: inherit;
    cursor: pointer;
  }
  .ftr__note {
    color: var(--ig-gray-500);
    font-weight: 400;
  }

  /* ── compliance badges ──
   * A tight row of small 38px marks, not the large seals they are shipped as —
   * the source images are 200–500px, so the size here is doing real work. */
  .ftr__badges {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    padding: 28px 0 40px;
  }
  /* `contain` on all three, not just the shield: none of the source marks are
   * exactly square, and letterboxing inside the 38px box is what keeps a seal
   * round instead of subtly oval. */
  .ftr__badges img {
    width: 38px;
    height: 38px;
    object-fit: contain;
    display: block;
  }
  .ftr__badges img.ftr__badge--shield {
    width: 36px;
  }

  .ftr__copyright {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 22px var(--ig-section-x);
    text-align: center;
    font-size: 13px;
    color: var(--ig-gray-500);
  }

  /* ── responsive ──
   * ≥1200: four columns with the newsletter beside them (above).
   * 700–1199: the columns take the full width; the newsletter becomes a band
   *   below them, heading left and form right.
   * <700: each group is an accordion and everything stacks. */
  @media (max-width: 1199px) {
    .ftr__body {
      flex-direction: column;
      gap: 40px;
    }
    .ftr__columns {
      min-width: 0;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px 28px;
    }
    .ftr__news {
      flex: none;
      min-width: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 16px 48px;
      align-items: start;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 699px) {
    .ftr {
      padding-top: 48px;
    }
    .ftr__social {
      gap: 22px;
      margin-bottom: 36px;
    }
    .ftr__body {
      gap: 36px;
      padding-bottom: 36px;
    }
    .ftr__columns {
      display: block;
    }
    .ftr__col {
      gap: 0;
    }
    .ftr__group {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .ftr__group-title {
      margin: 0;
      padding: 16px 0;
      cursor: pointer;
    }
    .ftr__chev {
      display: block;
    }
    .ftr__group[open] .ftr__chev {
      transform: rotate(180deg);
    }
    .ftr__group-links {
      padding-bottom: 18px;
    }
    .ftr__news {
      display: block;
      padding-top: 0;
      border-top: 0;
    }
    .ftr__news-title {
      font-size: 24px;
    }
    .ftr__legal {
      gap: 12px 24px;
      padding-top: 8px;
    }
  }
</style>

<!--
  No form client here. If you passed `newsletter`, mount your own against the
  `[data-lead-form]` wrapper above and read the config off `data-lead-config`;
  the marketing site uses `components/forms/leadForm.ts` for exactly that. The
  accordion below is the footer's own and always runs.
-->
<script>
  /* The link groups are an accordion on phones only. Keep this query in step
   * with the `max-width: 699px` block above. */
  const phone = window.matchMedia('(max-width: 699px)');
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-ftr-group]'));
  const syncGroups = () => {
    for (const g of groups) {
      g.open = !phone.matches;
      /* Wider than a phone the title is a plain heading: not a tab stop. */
      g.querySelector('summary')!.tabIndex = phone.matches ? 0 : -1;
    }
  };
  for (const g of groups) {
    g.querySelector('summary')!.addEventListener('click', (e) => {
      if (!phone.matches) e.preventDefault();
    });
  }
  phone.addEventListener('change', syncGroups);
  syncGroups();
</script>

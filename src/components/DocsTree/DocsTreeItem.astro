---
/**
 * Recursive renderer for a single TreeNode.
 *
 * Three shapes a node can take:
 *   1. Group     — no `href`                     → label is a <div slot="label">
 *                  (children optional: an empty group still renders as a group,
 *                  its chevron column kept but hidden, rather than as a leaf)
 *   2. Leaf      — has `href`, no `children`     → label is wrapped in <a slot="label">
 *   3. Link+kids — has `href` AND `children`     → toc h2 with h3 children
 *
 * Sets `data-tree-id`, `data-depth`, and `data-has-children` (when applicable).
 * Any extra `data-*` attributes come from `node.itemData` (kebab-cased keys).
 *
 * The expand/collapse chevron is rendered in the label slot *before* the
 * text (leading position), never in igc-tree-item's native `indicator` part,
 * which is hidden globally via `::part(indicator)`. Nesting is expressed with
 * the native `indentation` part (see `--igc-tree-indentation-size` in
 * docs-tree.scss), so a nested group's chevron sits in its parent's label
 * column.
 *
 * The `active` attribute is intentionally NOT set on <igc-tree-item>:
 * setting it triggers IgcTreeItemComponent.activeChange() synchronously
 * during defineComponents(), before the tree is upgraded, crashing on
 * `this.tree?.expandToItem`. Active-row highlight is CSS-driven via
 * `igc-tree-item:has(a[aria-current])` instead.
 */
import type { TreeNode, TreeVariant } from './types';

interface Props {
  node: TreeNode;
  depth: number;
  variant: TreeVariant;
  activeId?: string;
  renderLabel?: any;
}

const { node, depth, variant, activeId, renderLabel: RenderLabel } = Astro.props;

const hasChildren = !!(node.children && node.children.length > 0);
// A leaf is a link with nothing under it. A node without an href is a group even when it has no
// children (a toc section whose pages were all filtered out for a platform): treating it as a leaf
// put the leaf label layout under a group's chevron row, which rendered as an empty row with the
// label wrapped below it.
const isLeaf = !!node.href && !hasChildren;
const isActive = activeId !== undefined && node.id === activeId;

// Fold itemData entries into a plain object of `data-*` props so Astro spreads
// them onto <igc-tree-item>. Keys are camelCase → Astro converts to kebab.
const dataAttrs: Record<string, string> = {};
if (node.itemData) {
  for (const [key, value] of Object.entries(node.itemData)) {
    dataAttrs[`data-${key.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase())}`] = value;
  }
}
---

<igc-tree-item
  data-tree-id={node.id}
  data-depth={String(depth)}
  data-has-children={hasChildren ? '' : undefined}
  expanded={node.expanded ? '' : undefined}
  {...dataAttrs}
>
  {node.href ? (
    <div slot="label">
      {/* The anchor is used only for navigation purpose it behave as an overlay on the ::part(wrapper) */}
      <a
        href={node.href}
        aria-current={isActive ? 'page' : undefined}
        class="docs-tree-link"
        {...node.linkAttrs}
      />
      {hasChildren && <igc-icon name="chevron" collection="docs" class="tree-expand-icon" />}
      {RenderLabel ? (
        <RenderLabel node={node} depth={depth} isLeaf={isLeaf} isActive={isActive} />
      ) : (
        <span class="docs-tree-label">{node.label}</span>
      )}
    </div>
  ) : (
    <div slot="label" class="docs-tree-group">
      {/* An empty group keeps the chevron's column, so its label lines up with its siblings',
            but shows nothing to expand. */}
      <igc-icon
        name="chevron"
        collection="docs"
        class:list={['tree-expand-icon', { 'is-placeholder': !hasChildren }]}
        aria-hidden={hasChildren ? undefined : 'true'}
      />
      {RenderLabel ? (
        <RenderLabel node={node} depth={depth} isLeaf={isLeaf} isActive={isActive} />
      ) : (
        <span class="docs-tree-label">{node.label}</span>
      )}
    </div>
  )}

  {hasChildren &&
    node.children!.map((child) => (
      <Astro.self
        node={child}
        depth={depth + 1}
        variant={variant}
        activeId={activeId}
        renderLabel={RenderLabel}
      />
    ))}
</igc-tree-item>

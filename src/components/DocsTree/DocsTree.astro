---
/**
 * DocsTree — the base tree component shared by DocsSidebar and DocsToc.
 *
 * Wraps <igc-tree>, registers the underlying web components, imports the
 * single styling locus, and recursively renders nodes via DocsTreeItem.
 *
 * Variants are selected with `variant="sidebar" | "toc"` and styled by
 * attribute selectors in `docs-tree.css`. Variant-specific label content
 * (badges, carets) is supplied by the optional `renderLabel` prop.
 *
 * Active-state contract:
 *   • Sidebar passes `activeId` and never mutates aria-current at runtime.
 *   • Toc never passes `activeId`; its <docs-toc> wrapper owns aria-current
 *     after hydration.
 *   Passing both would flicker — see ./README.md.
 */
import type { TreeNode, TreeVariant } from './types';
import DocsTreeItem from './DocsTreeItem.astro';
import './docs-tree.scss';

interface Props {
  nodes: TreeNode[];
  variant: TreeVariant;
  /** SSR-time active id; matched against TreeNode.id. */
  activeId?: string;
  /** Pass-through to <igc-tree>. Sidebar: true. Toc: omit. */
  toggleNodeOnClick?: boolean;
  /** Accessible label for the tree's nav role. Skip when an outer <nav aria-labelledby> already names the region. */
  ariaLabel?: string;
  /**
   * Astro component rendering the label slot's inner content. Receives
   * `{ node, depth, isLeaf, isActive }`. When omitted, the tree falls
   * back to a plain `<span>{node.label}</span>`.
   */
  renderLabel?: any;
}

const { nodes, variant, activeId, toggleNodeOnClick, ariaLabel, renderLabel } = Astro.props;
---

<igc-tree
  data-variant={variant}
  aria-label={ariaLabel}
  toggle-node-on-click={toggleNodeOnClick ? '' : undefined}
>
  {nodes.map((node) => (
    <DocsTreeItem
      node={node}
      depth={0}
      variant={variant}
      activeId={activeId}
      renderLabel={renderLabel}
    />
  ))}
</igc-tree>

<script>
  import {
    defineComponents,
    IgcTreeComponent,
    IgcTreeItemComponent,
    IgcIconComponent,
  } from 'igniteui-webcomponents';
  import '../../scripts/icon-registry';

  defineComponents(IgcTreeComponent, IgcTreeItemComponent, IgcIconComponent);

  function selectActiveTreeItem() {
    customElements.whenDefined('igc-tree-item').then(() => {
      document.querySelectorAll<IgcTreeItemComponent>('igc-tree-item').forEach((item) => {
        const isActive = !!item.querySelector('a[aria-current="page"]');
        item.selected = isActive;
      });
    });
  }

  selectActiveTreeItem();
  document.addEventListener('astro:page-load', selectActiveTreeItem);

  // Restore sidebar focus when navigation was triggered from within the tree.
  // Astro's ClientRouter moves focus to main content on every page-load;
  // this counteracts that for keyboard users browsing the sidebar.
  let focusWasInTree = false;

  document.addEventListener('astro:before-preparation', () => {
    focusWasInTree = !!document.activeElement?.closest('igc-tree[data-variant="sidebar"]');
  });

  document.addEventListener('astro:page-load', () => {
    if (!focusWasInTree) return;
    focusWasInTree = false;
    customElements.whenDefined('igc-tree-item').then(() => {
      const activeItem = document.querySelector<HTMLElement>(
        'igc-tree[data-variant="sidebar"] igc-tree-item:has(a[aria-current="page"])'
      );
      activeItem?.focus();
    });
  });

  // When clicking a tree link, focus the parent igc-tree-item so that
  // up/down arrow key navigation works immediately after the click.
  // The <a> overlay is position:absolute and captures clicks, but igc-tree's
  // keyboard handler only fires when igc-tree-item itself has focus.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest('igc-tree[data-variant="sidebar"] a.docs-tree-link');
    if (!link) return;
    link.closest<HTMLElement>('igc-tree-item')?.focus();
  }, { capture: true });

  // Suppress the active-indicator transition during window resize so the
  // anchor-positioned ::before bar doesn't slowly slide to its new position.
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    document.body.classList.add('is-resizing');
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => document.body.classList.remove('is-resizing'), 150);
  }, { passive: true });
</script>

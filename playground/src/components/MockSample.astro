---
/**
 * Playground-only component that renders a fully pre-baked Sample widget shell.
 * All tabs are server-rendered so the playground does not need a real demos server.
 * sample-widget.ts wires tab switching and copy buttons on the client.
 */

interface CodeTab {
  label: string;
  lang: string;
  content: string;
}

interface Props {
  id: string;
  src?: string;
  height?: number;
  alt?: string;
  tabs?: CodeTab[];
  /** Opt in to the in-sample theme picker for this mock sample. */
  showThemePicker?: boolean;
  /** Same semantics as Sample.astro: content dictates the iframe size, `height` ignored. */
  fitContent?: boolean;
  /** Same semantics as Sample.astro: remove the container border. */
  noBorder?: boolean;
  /** Same semantics as Sample.astro: align the iframe, e.g. "center", "end top". */
  position?: string;
}

import ThemingWidget from '../../../src/components/ThemingWidget/ThemingWidget.astro';

const {
  // height mirrors Sample.astro's default (150) so a snippet that omits it
  // renders here exactly as the real component would.
  id,
  src = '/mock-demo',
  height = 150,
  alt = 'React Example',
  tabs,
  showThemePicker = false,
  fitContent = false,
  noBorder = false,
  position,
} = Astro.props;

const exampleTabId = `${id}-example`;

// Mirror Sample.astro's container computation so the pre-baked shell renders
// the exact same markup the real component would.
const posTokens = (position ?? '').toLowerCase().split(/\s+/).filter(Boolean);
const hToken =
  posTokens.find((t) => t === 'start' || t === 'end') ??
  (posTokens.includes('center') ? 'center' : undefined);
const vToken =
  posTokens.find((t) => t === 'top' || t === 'bottom') ??
  (posTokens.includes('center') ? 'center' : undefined);
const useFlex = Boolean(hToken || vToken);
const containerStyle = fitContent ? undefined : `height: ${height}px`;

const defaultTabs: CodeTab[] = [
  {
    label: 'TSX',
    lang: 'tsx',
    content: `import React from 'react';
import { IgrGrid, IgrColumn, IgrGridModule } from 'igniteui-react-grids';
import 'igniteui-react-grids/grids/themes/light/bootstrap.css';
import './GridSample.css';

IgrGridModule.register();

const DATA = [
  { ID: 1, Name: 'Alice Johnson', Age: 32, City: 'London',  Role: 'Engineer'  },
  { ID: 2, Name: 'Bob Martinez',  Age: 28, City: 'Berlin',  Role: 'Designer'  },
  { ID: 3, Name: 'Carol Zhang',   Age: 35, City: 'Tokyo',   Role: 'Manager'   },
  { ID: 4, Name: 'David Kim',     Age: 41, City: 'Seoul',   Role: 'Architect' },
  { ID: 5, Name: 'Eve Mueller',   Age: 29, City: 'Vienna',  Role: 'Engineer'  },
];

export default function GridSample() {
  return (
    <div className="grid-wrapper">
      <IgrGrid data={DATA} height="340px" width="100%" primaryKey="ID">
        <IgrColumn field="ID"   header="ID"   dataType="number" width="80px"  />
        <IgrColumn field="Name" header="Name" sortable={true}   width="180px" />
        <IgrColumn field="Age"  header="Age"  dataType="number" width="100px" />
        <IgrColumn field="City" header="City" sortable={true}   width="140px" />
        <IgrColumn field="Role" header="Role" sortable={true}                 />
      </IgrGrid>
    </div>
  );
}`,
  },
  {
    label: 'CSS',
    lang: 'css',
    content: `.grid-wrapper {
  padding: 16px;
}`,
  },
];

const resolvedTabs: CodeTab[] = tabs ?? defaultTabs;

function tabId(index: number) {
  return `${id}-code-${index}`;
}
---

<div
  class="igd-code-view"
  id={id}
  data-iframe-src={src}
  data-demos-base-url=""
  data-github-src={src.replace(/^\//, '')}
  data-platform="react"
>
  <div class="igd-code-view__inner">
    <igc-tabs id={`${id}-tabs`} alignment="start">
      <igc-tab id={exampleTabId} label="EXAMPLE" selected>
        <div
          class="igd-sample-container loading"
          data-spacing="md"
          aria-busy="true"
          style={containerStyle}
        >
          <igc-circular-progress
            indeterminate
            class="sample-loading-indicator"
            aria-label="Loading sample"></igc-circular-progress>
          <iframe
            data-src={src}
            title={alt}
            style="width: 100%; height: 100%;"
            frameborder="0"
            seamless
            aria-hidden="true"></iframe>
        </div>
      </igc-tab>
      {
        resolvedTabs.map((tab, i) => (
          <igc-tab id={tabId(i)} label={tab.label}>
            <div class="code-wrapper">
              <pre>
                <code class={`language-${tab.lang}`}>{tab.content}</code>
              </pre>
              <igc-icon-button variant="flat" aria-label="Copy code" class="cv-hljs-code-copy">
                <igc-icon name="copy" collection="docs" />
              </igc-icon-button>
            </div>
          </igc-tab>
        ))
      }
    </igc-tabs>
  </div>

  {
    showThemePicker && (
      <div class="igd-sample-theming" hidden>
        <ThemingWidget storageKey="igd-sample-theme" />
      </div>
    )
  }
</div>

<script>
  import { initSampleWidgets } from '../../../src/scripts/sample-widget';
  document.addEventListener('astro:page-load', initSampleWidgets);
</script>

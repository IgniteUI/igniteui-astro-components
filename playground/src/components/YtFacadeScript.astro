---
// Client-side YouTube facade activation script.
// Imported in styleguide.mdx to avoid MDX parsing issues with <script> template literals.
---
<script>
  document.querySelectorAll('.yt-facade').forEach((facade) => {
    const activate = () => {
      const el = facade as HTMLElement;
      const id    = el.dataset.videoId!;
      const title = el.dataset.videoTitle ?? 'YouTube video';
      const iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube.com/embed/' + id + '?si=SSNb8R8DmVUl0ium&autoplay=1';
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
      el.replaceChildren(iframe);
      el.removeAttribute('role');
      el.removeAttribute('tabindex');
      el.removeAttribute('aria-label');
      el.style.cursor = 'default';
    };
    facade.addEventListener('click', activate);
    facade.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        activate();
      }
    });
  });
</script>

---
import DocsLayout from '../../../../src/layouts/DocsLayout/DocsLayout.astro';
import DocsSidebar from '../../../../src/components/DocsSidebar/DocsSidebar.astro';
import DocsToc from '../../../../src/components/DocsToc/DocsToc.astro';
import PlatformBlock from '../../../../src/components/mdx/PlatformBlock/PlatformBlock.astro';
import DocsSubHeader from '../../../../src/components/DocsSubHeader/DocsSubHeader.astro';
import SearchAdvanced from '../../../../src/components/SearchAdvanced/SearchAdvanced.astro';
import {
  SITE_TITLE,
  SIDEBAR,
  PRODUCT_LINKS,
  SEARCH_TABS,
  PACKAGES,
  VERSIONS,
} from '../../site-config';

const slug = 'components/platform-block';

const headings = [
  { depth: 2, slug: 'single-platform', text: 'Single platform' },
  { depth: 2, slug: 'multi-platform', text: 'Multi-platform' },
];
---

<DocsLayout title="PlatformBlock" siteTitle={SITE_TITLE} hasSidebar currentSlug={slug}>
  <DocsSubHeader
    slot="subheader"
    pageTitle="PlatformBlock"
    currentSlug={slug}
    siteTitle={SITE_TITLE}
    productLinks={PRODUCT_LINKS}
    showThemeToggle={true}
    packages={[...PACKAGES]}
    selectedPackage={PACKAGES[0].value}
    versions={[...VERSIONS]}
    selectedVersion={VERSIONS[0]}
  >
    <SearchAdvanced slot="search" tabs={SEARCH_TABS} showScope={true} />
  </DocsSubHeader>
  <DocsSidebar slot="sidebar" items={SIDEBAR} currentSlug={slug} />
  <DocsToc slot="toc" headings={headings} offsetTarget=".docs-subheader" />
  <h1>PlatformBlock</h1>
  <p>Only the block matching the current <code>PLATFORM</code> env var renders.</p>

  <h2 id="single-platform">Single platform</h2>
  <PlatformBlock for="Angular">
    <p><strong>Angular</strong> only.</p>
  </PlatformBlock>
  <PlatformBlock for="React">
    <p><strong>React</strong> only.</p>
  </PlatformBlock>
  <PlatformBlock for="WebComponents">
    <p><strong>Web Components</strong> only.</p>
  </PlatformBlock>
  <PlatformBlock for="Blazor">
    <p><strong>Blazor</strong> only.</p>
  </PlatformBlock>

  <h2 id="multi-platform">Multi-platform</h2>
  <PlatformBlock for="Angular, React">
    <p>Visible to <strong>Angular</strong> and <strong>React</strong>.</p>
  </PlatformBlock>
</DocsLayout>

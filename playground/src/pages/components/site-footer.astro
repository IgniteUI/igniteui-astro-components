---
/**
 * SiteFooter - the default, then everything opted in (newsletter + Cookie
 * Settings), which is the variant the marketing site renders.
 */
import SiteFooter from '../../../../src/components/SiteFooter/SiteFooter.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SiteFooter — playground</title>
    <style>
      body {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <main style="padding: 40px; font-family: system-ui">
      <h1>SiteFooter</h1>
      <p>Below: default (no newsletter, no Cookie Settings), then both opted in.</p>
    </main>
    <SiteFooter />
    <SiteFooter
      newsletter={{ config: { leadSourceNumber: '9100010', eventDetail: 'newsletter signup' } }}
      cookieSettings
    />
  </body>
</html>

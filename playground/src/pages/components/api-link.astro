---
import DocsLayout from '../../../../src/layouts/DocsLayout/DocsLayout.astro';
import DocsSidebar from '../../../../src/components/DocsSidebar/DocsSidebar.astro';
import DocsToc from '../../../../src/components/DocsToc/DocsToc.astro';
import ApiLink from '../../../../src/components/mdx/ApiLink/ApiLink.astro';
import DocsSubHeader from '../../../../src/components/DocsSubHeader/DocsSubHeader.astro';
import SearchAdvanced from '../../../../src/components/SearchAdvanced/SearchAdvanced.astro';
import { SITE_TITLE, SIDEBAR, PRODUCT_LINKS, SEARCH_TABS, PACKAGES, VERSIONS } from '../../site-config';

const slug = 'components/api-link';

const headings = [
  { depth: 2, slug: 'class-link',     text: 'Class link' },
  { depth: 2, slug: 'class-member',   text: 'Class member' },
  { depth: 2, slug: 'function',       text: 'Function' },
  { depth: 2, slug: 'type-alias',     text: 'Type alias' },
  { depth: 2, slug: 'sub-package',    text: 'Sub-package' },
  { depth: 2, slug: 'platform-overrides', text: 'Platform overrides' },
  { depth: 2, slug: 'sass-links',     text: 'Sass links' },
  { depth: 2, slug: 'platform-env',   text: 'Platform env var' },
];
---

<DocsLayout title="ApiLink" siteTitle={SITE_TITLE} hasSidebar currentSlug={slug}>
  <DocsSubHeader slot="subheader" pageTitle="ApiLink" currentSlug={slug} siteTitle={SITE_TITLE}
    productLinks={PRODUCT_LINKS} showThemeToggle={true}
    packages={[...PACKAGES]} selectedPackage={PACKAGES[0].value}
    versions={[...VERSIONS]} selectedVersion={VERSIONS[0]}
  >
    <SearchAdvanced slot="search" tabs={SEARCH_TABS} showScope={true} />
  </DocsSubHeader>
  <DocsSidebar slot="sidebar" items={SIDEBAR} currentSlug={slug} />
  <DocsToc slot="toc" headings={headings} offsetTarget=".docs-subheader" />
    <h1>ApiLink</h1>
    <p>Renders an inline <code>&lt;a&gt;&lt;code&gt;</code> link to the platform-appropriate API page.</p>

    <h2 id="class-link">Class link</h2>
    <p>Default: <ApiLink type="Toast" /></p>

    <h2 id="class-member">Class member</h2>
    <p><ApiLink type="Toast" member="show" label="Show" /></p>

    <h2 id="function">Function</h2>
    <p>Functions render without a class prefix: <ApiLink kind="function" type="configureTheme" prefixed={false} /></p>

    <h2 id="type-alias">Type alias</h2>
    <p><ApiLink kind="type" type="AbsolutePosition" prefixed={false} /></p>

    <h2 id="sub-package">Sub-package</h2>
    <p>Use the <code>pkg</code> prop to target a sub-package: <ApiLink pkg="charts" type="CategoryChart" /></p>

    <h2 id="platform-overrides">Platform overrides</h2>
    <p><code>exclude</code> renders plain code on matching platforms: <ApiLink type="Toast" member="show" exclude="React" /></p>
    <p><code>excludePrefixFor</code> keeps symbols unprefixed on matching platforms: <ApiLink pkg="charts" type="ChartSelection" excludePrefixFor="React" /></p>
    <p><code>excludeSuffixFor</code> suppresses framework class suffixes on matching platforms: <ApiLink pkg="charts" type="ChartSelection" excludeSuffixFor="React" /></p>

    <h2 id="sass-links">Sass links</h2>
    <p>Sass module page with prose label: <ApiLink kind="sass" module="animations" label="animations Sass module" code={false} /></p>
    <p>Sass API anchor with code label: <ApiLink kind="sass" module="animations" type="mixin-slide-in-left" label="slide-in-left" /></p>

    <h2 id="platform-env">Platform env var</h2>
    <p>Platform is set via <code>PLATFORM</code> env var in <code>astro.config.mjs</code> (defaults to <code>React</code>).</p>
</DocsLayout>

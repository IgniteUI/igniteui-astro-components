---
import MainLayout from '../../../../src/layouts/MainLayout.astro';
import DocsSidebar from '../../../../src/components/sidebar/DocsSidebar.astro';
import ApiLink from '../../../../src/components/mdx/ApiLink.astro';

const slug = '/components/api-link';
---

<MainLayout title="ApiLink" hasSidebar currentSlug={slug}>
  <DocsSidebar slot="sidebar" currentSlug={slug} />
  <main class="content">
    <h1>ApiLink</h1>
    <p>Renders an inline <code>&lt;a&gt;&lt;code&gt;</code> link to the platform-appropriate API page.</p>
    <p>
      Default class link: <ApiLink type="Toast" />
    </p>
    <p>
      Class member: <ApiLink type="Toast" member="show" label="Show" />
    </p>
    <p>
      Function (no prefix): <ApiLink kind="function" type="configureTheme" prefixed={false} />
    </p>
    <p>
      Type alias: <ApiLink kind="type" type="AbsolutePosition" prefixed={false} />
    </p>
    <p>
      Sub-package class: <ApiLink pkg="charts" type="CategoryChart" />
    </p>
    <p>Platform is set via <code>PLATFORM</code> env var in <code>astro.config.mjs</code> (defaults to <code>React</code>).</p>
  </main>
</MainLayout>

<style>
  .content { max-width: 60rem; margin: 0 auto; padding: 2rem 1.5rem; }
</style>

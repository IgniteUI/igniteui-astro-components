---
import DocsLayout from '../../../../src/layouts/DocsLayout/DocsLayout.astro';
import DocsSidebar from '../../../../src/components/DocsSidebar/DocsSidebar.astro';
import DocsToc from '../../../../src/components/DocsToc/DocsToc.astro';
import DocsSubHeader from '../../../../src/components/DocsSubHeader/DocsSubHeader.astro';
import SearchAdvanced from '../../../../src/components/SearchAdvanced/SearchAdvanced.astro';
import {
  SITE_TITLE,
  SIDEBAR,
  PRODUCT_LINKS,
  SEARCH_TABS,
  PACKAGES,
  VERSIONS,
} from '../../site-config';

const slug = 'components/docs-subheader';

const headings = [
  { depth: 2, slug: 'features', text: 'Features shown above' },
  { depth: 3, slug: 'advanced-search', text: 'Advanced search' },
  { depth: 3, slug: 'package-selector', text: 'Package selector' },
  { depth: 3, slug: 'version-selector', text: 'Version selector' },
];
---

<DocsLayout title="DocsSubHeader" siteTitle={SITE_TITLE} hasSidebar currentSlug={slug}>
  <DocsSubHeader
    slot="subheader"
    packages={[...PACKAGES]}
    selectedPackage={PACKAGES[0].value}
    packageLabel="Package"
    versions={[...VERSIONS]}
    selectedVersion={VERSIONS[0]}
    versionLabel="Version"
  >
    <SearchAdvanced slot="search" tabs={SEARCH_TABS} showScope={true} />
  </DocsSubHeader>
  <DocsSidebar slot="sidebar" items={SIDEBAR} currentSlug={slug} />
  <DocsToc slot="toc" headings={headings} offsetTarget=".docs-subheader" />

  <h1>DocsSubHeader</h1>
  <p>
    The subheader bar above this content is rendered with every prop set. The selector props are
    also available on <code>DocsLayout</code>, which forwards them to
    <code>DocsSubHeader</code>. The breadcrumb below the bar is <code>DocsBreadcrumb</code>,
    rendered by the layout.
  </p>

  <h2 id="features">Features shown above</h2>

  <h3 id="advanced-search">Advanced search</h3>
  <p>
    Setting <code>advancedSearch</code> on <code>DocsLayout</code> (or placing{' '}
    <code>&lt;SearchAdvanced slot="search" /&gt;</code> directly on
    <code>DocsSubHeader</code>) replaces the default <code>Search</code>
    button with the tabbed <code>SearchAdvanced</code> dialog. It loads a JSON index from{' '}
    <code>indexUrl</code> and supports configurable tab categories, a scope selector, and a
    per-category result limit.
  </p>

  <h3 id="package-selector">Package selector</h3>
  <p>
    Pass a <code>packages</code> array and an optional
    <code>selectedPackage</code> to render an <code>igc-select</code>
    dropdown. The label can be customised with <code>packageLabel</code>
    (defaults to <code>"Package"</code>).
  </p>

  <h3 id="version-selector">Version selector</h3>
  <p>
    Pass a <code>versions</code> array and an optional
    <code>selectedVersion</code> to render a second <code>igc-select</code>
    dropdown. The label can be customised with <code>versionLabel</code>
    (defaults to <code>"Version"</code>).
  </p>
</DocsLayout>

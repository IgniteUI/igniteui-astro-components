---
import DocsLayout from '../../../src/layouts/DocsLayout/DocsLayout.astro';
import DocsSidebar from '../../../src/components/DocsSidebar/DocsSidebar.astro';
import DocsToc from '../../../src/components/DocsToc/DocsToc.astro';
import DocsSubHeader from '../../../src/components/DocsSubHeader/DocsSubHeader.astro';
import SearchAdvanced from '../../../src/components/SearchAdvanced/SearchAdvanced.astro';
import {
  SITE_TITLE,
  SIDEBAR,
  PRODUCT_LINKS,
  SEARCH_TABS,
  PACKAGES,
  VERSIONS,
} from '../site-config';

const headings = [
  { depth: 2, slug: 'pages', text: 'Pages' },
  { depth: 3, slug: 'layout-and-chrome', text: 'Layout and chrome' },
  { depth: 3, slug: 'mdx-components', text: 'MDX components' },
  { depth: 3, slug: 'styles', text: 'Styles' },
  { depth: 2, slug: 'how-it-works', text: 'How it works' },
  { depth: 3, slug: 'adding-a-demo-page', text: 'Adding a demo page' },
  { depth: 2, slug: 'further-reading', text: 'Further reading' },
];
---

<DocsLayout title="Playground" siteTitle={SITE_TITLE} hasSidebar currentSlug="">
  <DocsSubHeader
    slot="subheader"
    pageTitle="Playground"
    currentSlug=""
    siteTitle={SITE_TITLE}
    productLinks={PRODUCT_LINKS}
    showThemeToggle={true}
    packages={[...PACKAGES]}
    selectedPackage={PACKAGES[0].value}
    versions={[...VERSIONS]}
    selectedVersion={VERSIONS[0]}
  >
    <SearchAdvanced slot="search" tabs={SEARCH_TABS} showScope={true} />
  </DocsSubHeader>
  <DocsSidebar slot="sidebar" items={SIDEBAR} currentSlug="" />
  <DocsToc slot="toc" headings={headings} offsetTarget=".docs-subheader" />

  <h1>igniteui-astro-components playground</h1>
  <p>
    A local sandbox for the components shipped from <code>../src</code>. Every page renders one
    component (or one group of markdown styles) in isolation so it can be styled and smoke-tested
    without publishing the package or wiring it into a consumer site. The page you are reading is
    itself rendered by <code>DocsLayout</code>, <code>DocsSubHeader</code>, <code>DocsSidebar</code>
    and <code>DocsToc</code>.
  </p>

  <h2 id="pages">Pages</h2>

  <h3 id="layout-and-chrome">Layout and chrome</h3>
  <ul>
    <li>
      <a href="/components/sidebar">Sidebar</a> — <code>DocsSidebar</code> on top of
      <code>DocsTree</code> (<code>igc-tree</code>), with the filter input, badges, and a nesting
      preview for checking indentation.
    </li>
    <li>
      <a href="/components/nav-bar">Global nav &amp; footer</a> — <code>GlobalNavBar</code> and
      <code>GlobalFooter</code>, the marketing header and footer.
    </li>
    <li>
      <a href="/components/docs-subheader">DocsSubHeader</a> — secondary fixed bar with breadcrumb,
      search slot, package and version selectors, theme toggle, and product links.
    </li>
    <li>
      <a href="/components/docs-toc">DocsToc</a> — "On this page" table of contents with scroll-spy,
      plus <code>MobileTocToggle</code>.
    </li>
    <li>
      <a href="/components/search">Search</a> — Pagefind search dialog (the trigger renders; the
      index only exists after a production build).
    </li>
    <li>
      <a href="/components/search-advanced">SearchAdvanced</a> — tabbed API search over the JSON
      index in <code>public/api-search-index/</code>.
    </li>
    <li>
      <a href="/components/theming-widget">ThemingWidget</a> — theme, mode and size picker used by
      the Sample component.
    </li>
  </ul>

  <h3 id="mdx-components">MDX components</h3>
  <ul>
    <li>
      <a href="/components/anatomy">Anatomy</a> — framed, centered canvas for component anatomy
      images.
    </li>
    <li>
      <a href="/components/api-link">ApiLink</a> — inline link to an API reference entry.
    </li>
    <li>
      <a href="/components/api-ref">ApiRef</a> — full API reference block.
    </li>
    <li>
      <a href="/components/badge">Badge</a> — inline status chips (preview, new, updated, premium,
      opensource).
    </li>
    <li>
      <a href="/components/docs-aside">DocsAside</a> — note, info and warning callout blocks.
    </li>
    <li>
      <a href="/components/do-dont">DoDont</a> — side-by-side Do / Don't image guidance panels.
    </li>
    <li>
      <a href="/components/faq">Faq</a> — <code>Faq</code> and <code>FaqItem</code> accordion.
    </li>
    <li>
      <a href="/components/platform-block">PlatformBlock</a> — conditionally renders content per
      platform.
    </li>
    <li>
      <a href="/components/sample">Sample</a> — embedded demo iframe with code tabs and theme
      picker; the <code>/mock-demo*</code> pages are its iframe targets.
    </li>
  </ul>

  <h3 id="styles">Styles</h3>
  <p>
    One MDX page per topic, rendered through <code>PlaygroundMdxLayout</code> so the markdown styles
    in <code>theme.scss</code> can be checked against real content:
    <a href="/styles/colors">Colors</a>, <a href="/styles/typography">Typography</a>,
    <a href="/styles/icons">Icons</a>, <a href="/styles/lists">Lists</a>,
    <a href="/styles/tables">Tables</a>, <a href="/styles/code">Code</a>,
    <a href="/styles/images">Images</a>, <a href="/styles/media">Embedded media</a>,
    <a href="/styles/badges">Badges</a> and <a href="/styles/text-elements">Text elements</a>.
  </p>

  <h2 id="how-it-works">How it works</h2>
  <p>
    The playground does not use the package's <code>createDocsSite</code> integration. It shows the
    prop-driven setup every consumer uses instead:
  </p>
  <ul>
    <li>
      Site title, product links, sidebar tree, search tabs, packages and versions live in
      <code>playground/src/site-config.ts</code> and are passed as props to
      <code>DocsLayout</code>, <code>DocsSidebar</code> and <code>DocsSubHeader</code>.
    </li>
    <li>
      <code>astro.config.mjs</code> registers a small Vite plugin that stubs the two virtual modules
      (<code>virtual:docs-template/site-meta</code> and
      <code>virtual:docs-template/nav-html</code>) the components import. Their
      <code>sidebar</code>, <code>title</code> and <code>productLinks</code> exports are
      intentionally empty; the real data flows through props.
    </li>
    <li>
      <code>playground/src/middleware.ts</code> sets <code>Astro.locals.platformContext</code> (a
      mock React context) and <code>Astro.locals.envVars</code>, which <code>ApiLink</code>,
      <code>ApiRef</code>, <code>PlatformBlock</code>, <code>Sample</code> and
      <code>ThemingWidget</code> read. Change <code>MOCK_PLATFORM</code> there to see
      platform-conditional output flip.
    </li>
    <li>
      Components are imported by relative path (<code>../../../src/...</code>), so no
      <code>npm link</code> or <code>file:</code> install is needed.
    </li>
    <li>
      Set <code>IG_CHROME_SNAPSHOT=&lt;folder&gt;</code> to render the marketing site's exported
      header and footer from a snapshot; without it the legacy fetched chrome is used.
    </li>
  </ul>

  <h3 id="adding-a-demo-page">Adding a demo page</h3>
  <ol>
    <li>
      Create <code>playground/src/pages/components/&lt;name&gt;.astro</code> (or an
      <code>.mdx</code> file under <code>pages/styles/</code> using
      <code>PlaygroundMdxLayout</code>) and import the component under test from
      <code>../../../../src/</code>. Render every variant and state worth looking at.
    </li>
    <li>
      Add the route to the <code>SIDEBAR</code> tree in <code>site-config.ts</code> so it appears in
      the navigation, and link it from the list above.
    </li>
    <li>
      Add the route to the pages table in <code>playground/README.md</code>.
    </li>
  </ol>

  <h2 id="further-reading">Further reading</h2>
  <ul>
    <li>
      <code>playground/README.md</code> — commands, wiring and the full page table.
    </li>
    <li>
      <code>README.md</code> at the repository root — consumer setup, exports and host requirements.
    </li>
    <li>
      <code>llms.txt</code> — the one-page index of every export with its props.
    </li>
    <li>
      <code>CONTRIBUTING.md</code> — component anatomy, README template, tests and releases.
    </li>
  </ul>
</DocsLayout>

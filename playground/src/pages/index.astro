---
import MainLayout from '../../../src/layouts/MainLayout.astro';
import DocsSidebar from '../../../src/components/sidebar/DocsSidebar.astro';
---

<MainLayout title="Playground" hasSidebar currentSlug="/">
  <DocsSidebar slot="sidebar" currentSlug="/" />

  <main class="content">
    <h1>igniteui-astro-components playground</h1>
    <p>
      This is a local sandbox for the components shipped from
      <code>../src</code>. Use the sidebar to explore the dedicated demo
      pages for each component.
    </p>

    <h2>Pages</h2>
    <ul>
      <li><a href="/components/sidebar">Sidebar</a></li>
      <li><a href="/components/nav-bar">Global nav &amp; footer</a></li>
      <li><a href="/components/api-link">ApiLink</a></li>
      <li><a href="/components/api-ref">ApiRef</a></li>
      <li><a href="/components/platform-block">PlatformBlock</a></li>
    </ul>

    <h2>How it works</h2>
    <p>
      The playground bypasses <code>createDocsSite()</code> and stubs the
      <code>virtual:docs-template/site-meta</code> and
      <code>virtual:docs-template/nav-html</code> modules from
      <code>astro.config.mjs</code>. Edit
      <code>astro.config.mjs</code> to tweak the sample sidebar, product
      links or platform key.
    </p>
  </main>
</MainLayout>

<style>
  .content {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .content h1 { margin-top: 0; }
  .content code {
    background: var(--sl-color-bg-inline-code);
    padding: 0.1em 0.35em;
    border-radius: 0.25em;
    font-size: 0.9em;
  }
  .content ul { line-height: 1.8; }
</style>

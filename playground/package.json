{
  "name": "igniteui-astro-components-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local playground for visually testing the igniteui-astro-components package without publishing it.",
  "scripts": {
    "dev": "astro sync && astro dev --port 4567",
    "build": "astro clean && astro sync && astro build",
    "preview": "astro sync && astro preview --port 4567",
    "check": "astro check",
    "clean": "astro clean"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "igniteui-theming": "*",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "igniteui-webcomponents": "^7.2.4",
    "sanitize-html": "^2.17.3"
  }
}
